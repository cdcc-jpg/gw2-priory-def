@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix currency: <https://priory.gw2/ref/currency/> .

# ==============================================================================
# Competitive, Raid & Endgame Tokens and Currencies
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. World vs. World (WvW)
# ------------------------------------------------------------------------------
item:78895 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "WvW Skirmish Claim Ticket"@en ;
    priory:gw2Id 78895 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound true ;
    skos:definition "Weekly time-gated WvW currency (max 365/week) used for Conflux, Warbringer, and Mistforged Legendary Armor."@en .

item:71581 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Memory of Battle"@en ;
    priory:gw2Id 71581 ;
    priory:hasRarity rarity:Fine ;
    priory:isAccountBound false ;
    skos:definition "Tradeable WvW material earned from pips and reward tracks. Used in all competitive legendary gifts."@en .

