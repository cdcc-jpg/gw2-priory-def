# --- Tome of Knowledge (GW2 IDs: 19983, 43766) ---
item:19983 a priory:TomeOfKnowledge, priory:Item, owl:NamedIndividual ;
    rdfs:label "Tome of Knowledge"@en ;
    priory:gw2Id 19983 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound true ;
    rdfs:comment "Grants 1 character level or 1 Spirit Shard if consumed on a level 80 character."@en .

item:43766 a priory:TomeOfKnowledge, priory:Item, owl:NamedIndividual ;
    rdfs:label "Tome of Knowledge"@en ;
    priory:gw2Id 43766 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound true ;
    rdfs:comment "Grants 1 character level or 1 Spirit Shard if consumed on a level 80 character. Sourced from WvW/PvP reward tracks, daily logins, and Wizard's Vault."@en ;
    priory:acquiredVia [
        a priory:RewardTrackPath ;
        priory:hasGameMode gamemode:WvWRewardTrack ;
        rdfs:label "WvW / PvP Reward Track Progression"@en
    ] .

# ------------------------------------------------------------------------------
# 3. Guild Tavern Enhancements
# ------------------------------------------------------------------------------

guild_enhancement:wvw_track_10 a priory:ItemBuff, owl:NamedIndividual ;
    rdfs:label "Guild Tavern WvW Reward Track Enhancement"@en ;
    priory:duration "Indefinite / 24 hours" ;
    priory:accelerationMultiplier "1.1" ;
    rdfs:comment "Provides +10% bonus to WvW Reward Track progress from the Guild Tavern Bartender in the Guild Hall."@en ;
    priory:acquiredVia [
        a priory:VendorExchangePath ;
        rdfs:label "Guild Tavern Bartender Free Enhancement"@en ;
        priory:requiresCurrency currency:Coin ;
        priory:requiredQuantity 1
    ] .

guild_enhancement:karma_10 a priory:ItemBuff, owl:NamedIndividual ;
    rdfs:label "Guild Tavern Karma Enhancement"@en ;
    priory:duration "Indefinite / 24 hours" ;
    priory:accelerationMultiplier "1.1" ;
    rdfs:comment "Provides +10% bonus to Karma gain from the Guild Tavern Bartender in the Guild Hall."@en ;
    priory:acquiredVia [
        a priory:VendorExchangePath ;
        rdfs:label "Guild Tavern Bartender Free Enhancement"@en ;
        priory:requiresCurrency currency:Coin ;
        priory:requiredQuantity 1
    ] .

# ------------------------------------------------------------------------------
# 4. Semantic Buff Aliases (Compatibility with Core Ontology Instances)
# ------------------------------------------------------------------------------

priory:WvWRewardTrackBooster a priory:ItemBuff, owl:NamedIndividual ;
    rdfs:label "WvW Reward Track Booster"@en ;
    priory:duration "60 minutes" ;
    priory:accelerationMultiplier "1.5" ;
    rdfs:comment "Increases reward track progress in WvW by 50%."@en .

priory:ExperienceBooster a priory:ItemBuff, owl:NamedIndividual ;
    rdfs:label "Experience Booster"@en ;
    priory:duration "120 minutes" ;
    priory:accelerationMultiplier "1.5" ;
    rdfs:comment "Increases all experience gain by 50% and accelerates WvW reward track progression by 50%."@en .

priory:GuildTavernEnhancement a priory:ItemBuff, owl:NamedIndividual ;
    rdfs:label "Guild Tavern WvW Tavern Enhancement +10%"@en ;
    priory:duration "Indefinite" ;
    priory:accelerationMultiplier "1.1" ;
    owl:sameAs guild_enhancement:wvw_track_10 ;
    rdfs:comment "Provides up to 10% bonus to WvW Reward Track progress from the Guild Tavern enhancement."@en .

priory:HeroicBooster a priory:ItemBuff, owl:NamedIndividual ;
    rdfs:label "Heroic Booster"@en ;
    priory:duration "120 minutes" ;
    priory:accelerationMultiplier "1.5" ;
    rdfs:comment "Combines Experience Booster and Item Booster effects; increases WvW reward track gain by 50% and bonus experience by 50%."@en .

priory:KarmaBooster a priory:ItemBuff, owl:NamedIndividual ;
    rdfs:label "Karma Booster"@en ;
    priory:duration "60 minutes" ;
    priory:accelerationMultiplier "1.5" ;
    rdfs:comment "Increases all karma gain by 50%."@en .
