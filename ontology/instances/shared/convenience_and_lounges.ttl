# --- Copper-Fed Salvage-o-Matic (GW2 ID: 44602) ---
item:44602 a priory:InfiniteSalvageItem, priory:ConvenienceGizmo, priory:Item, owl:NamedIndividual ;
    rdfs:label "Copper-Fed Salvage-o-Matic"@en ;
    priory:gw2Id 44602 ;
    priory:chatCode "[&AgE6rgAA]" ;
    priory:chatLink "[&AgE6rgAA]" ;
    priory:hasRarity rarity:Rare ;
    priory:hasItemType itemtype:Gizmo ;
    priory:isAccountBound true ;
    priory:salvageCostPerUse 3 ;
    priory:salvageRarityRate 0.10 ;
    priory:salvageUpgradeRate 0.20 ;
    rdfs:comment "Infinite-use salvage tool costing 3 copper per use. Equivalent to a Basic Salvage Kit with 10% chance of rarer materials and 20% chance of recovering upgrades. Optimal for salvaging white, blue, and green equipment."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Copper-Fed_Salvage-o-Matic> .

# --- Silver-Fed Salvage-o-Matic (GW2 ID: 67027) ---
item:67027 a priory:InfiniteSalvageItem, priory:ConvenienceGizmo, priory:Item, owl:NamedIndividual ;
    rdfs:label "Silver-Fed Salvage-o-Matic"@en ;
    priory:gw2Id 67027 ;
