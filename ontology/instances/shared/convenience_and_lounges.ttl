    priory:chatLink "[&AgHTBQEA]" ;
    priory:hasRarity rarity:Rare ;
    priory:hasItemType itemtype:Gizmo ;
    priory:isAccountBound true ;
    priory:salvageCostPerUse 60 ;
    priory:salvageRarityRate 0.25 ;
    priory:salvageUpgradeRate 0.80 ;
    rdfs:comment "Infinite-use salvage tool costing 60 copper per use. Equivalent to a Master's Salvage Kit with 25% chance of rarer materials and 80% chance of recovering upgrades. Optimal for salvaging rare (yellow) gear for Globs of Ectoplasm."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Silver-Fed_Salvage-o-Matic> .

# --- Runecrafter's Salvage-o-Matic (GW2 ID: 87400) ---
item:87400 a priory:InfiniteSalvageItem, priory:ConvenienceGizmo, priory:Item, owl:NamedIndividual ;
    rdfs:label "Runecrafter's Salvage-o-Matic"@en ;
    priory:gw2Id 87400 ;
    priory:chatCode "[&AgFoVQEA]" ;
    priory:chatLink "[&AgFoVQEA]" ;
    priory:hasRarity rarity:Rare ;
    priory:hasItemType itemtype:Gizmo ;
    priory:isAccountBound true ;
    priory:salvageCostPerUse 30 ;
    priory:salvageRarityRate 0.20 ;
    priory:salvageUpgradeRate 1.00 ;
    rdfs:comment "Infinite-use salvage tool costing 30 copper per use. Features a 100% chance of recovering upgrades as Charms, Symbols, and Lucent Motes. Optimal for salvaging masterwork (green) gear containing sigils or runes."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Runecrafter%27s_Salvage-o-Matic> .

