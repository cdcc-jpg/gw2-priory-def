# ==============================================================================
# ETERNITY COMMERCIAL LOOP & POST-FORGE BINDING ARCHITECTURE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Legendary Greatswords (Eternity, Sunrise, Twilight)
# ------------------------------------------------------------------------------

item:30689 a priory:LegendaryWeapon, priory:Item, owl:NamedIndividual ;
    rdfs:label "Eternity"@en ;
    skos:altLabel "Gen 1 Greatsword"@en,
        "Gen 1 Legendary Greatsword"@en,
        "Gen One Greatsword"@en,
        "Generation 1 Greatsword"@en,
        "Generation One Greatsword"@en ;
    priory:gw2Id 30689 ;
    priory:chatCode "[&AgExZwAA]" ;
    priory:chatLink "[&AgExZwAA]" ;
    priory:hasRarity rarity:Legendary ;
    priory:hasWeaponType weapon:Greatsword ;
    priory:hasItemType <https://priory.gw2/ref/itemtype/Greatsword> ;
    priory:isAccountBound false ;
    priory:armoryMaxCap 1 ;
    priory:producedBy recipe:recipe_forge_eternity_unbound, recipe:recipe_forge_eternity_bound ;
    rdfs:comment "Generation 1 Legendary Greatsword formed by uniting Twilight and Sunrise. When forged from crafted/unbound precursors and weapons, Eternity is tradeable and unbound, enabling the Eternity Commercial Loop on the Black Lion Trading Post."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Eternity> .

item:30703 a priory:LegendaryWeapon, priory:Item, owl:NamedIndividual ;
    rdfs:label "Sunrise"@en ;
    skos:altLabel "Gen 1 Greatsword"@en,
        "Gen 1 Legendary Greatsword"@en,
        "Gen One Greatsword"@en,
        "Generation 1 Greatsword"@en,
        "The Legendary Greatsword"@en ;
    priory:gw2Id 30703 ;
    priory:chatCode "[&AgEvZwAA]" ;
    priory:chatLink "[&AgEvZwAA]" ;
    priory:hasRarity rarity:Legendary ;
    priory:hasWeaponType weapon:Greatsword ;
    priory:hasItemType <https://priory.gw2/ref/itemtype/Greatsword> ;
    priory:isAccountBound false ;
    priory:armoryMaxCap 1 ;
    rdfs:comment "Generation 1 Legendary Greatsword representing the light of day. Forged from Dawn, Gift of Mastery, Gift of Fortune, and Gift of Sunrise. Tradeable until bound to the account armory."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Sunrise> .

item:30704 a priory:LegendaryWeapon, priory:Item, owl:NamedIndividual ;
    rdfs:label "Twilight"@en ;
    skos:altLabel "Gen 1 Greatsword"@en,
        "Gen 1 Legendary Greatsword"@en,
        "Gen One Greatsword"@en,
        "Generation 1 Greatsword"@en,
        "The Legendary Greatsword"@en ;
    priory:gw2Id 30704 ;
    priory:chatCode "[&AgErZgAA]" ;
    priory:chatLink "[&AgErZgAA]" ;
    priory:hasRarity rarity:Legendary ;
    priory:hasWeaponType weapon:Greatsword ;
    priory:hasItemType <https://priory.gw2/ref/itemtype/Greatsword> ;
    priory:isAccountBound false ;
    priory:armoryMaxCap 1 ;
    rdfs:comment "Generation 1 Legendary Greatsword representing the darkness of night. Forged from Dusk, Gift of Mastery, Gift of Fortune, and Gift of Twilight. Tradeable until bound to the account armory."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Twilight> .


# ------------------------------------------------------------------------------
# 2. Armory-Bound Memories (Post-Forge Binding Mechanism)
# ------------------------------------------------------------------------------

item:94875 a priory:CraftingMaterial, priory:Item, owl:NamedIndividual ;
    rdfs:label "Memory of Twilight"@en ;
    skos:altLabel "Twilight Memory"@en ;
    priory:gw2Id 94875 ;
    priory:chatCode "[&AgFucwEA]" ;
    priory:chatLink "[&AgFucwEA]" ;
    priory:hasRarity rarity:Legendary ;
    priory:isAccountBound true ;
    rdfs:comment "An armory-bound trophy granted when Twilight is bound to your Legendary Armory. Used in the Mystic Forge to craft an Account Bound Eternity."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Memory_of_Twilight> .

item:94917 a priory:CraftingMaterial, priory:Item, owl:NamedIndividual ;
    rdfs:label "Memory of Sunrise"@en ;
    skos:altLabel "Sunrise Memory"@en ;
    priory:gw2Id 94917 ;
    priory:chatCode "[&AgGdcwEA]" ;
    priory:chatLink "[&AgGdcwEA]" ;
    priory:hasRarity rarity:Legendary ;
    priory:isAccountBound true ;
    rdfs:comment "An armory-bound trophy granted when Sunrise is bound to your Legendary Armory. Used in the Mystic Forge to craft an Account Bound Eternity."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Memory_of_Sunrise> .


