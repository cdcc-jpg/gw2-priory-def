    priory:chatLink "[&AgFsEwAA]" ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    rdfs:comment "Tier 6 fine crafting material used as catalyst in Mystic Forge recipes."@en .

