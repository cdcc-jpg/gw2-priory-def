# ------------------------------------------------------------------------------
# 4. Mystic Forge Eternity Recipes
# ------------------------------------------------------------------------------

# Unbound Eternity Forge Recipe (Twilight + Sunrise + 5 Crystalline Dust + 10 Mystic Coins -> Eternity)
recipe:recipe_forge_eternity_unbound a priory:MysticForgeRecipe, priory:Recipe, owl:NamedIndividual ;
    rdfs:label "Forge Eternity (Unbound)"@en ;
    priory:producesItem item:30689 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement
        recipe:req_eternity_unbound_twilight ,
        recipe:req_eternity_unbound_sunrise ,
        recipe:req_eternity_unbound_dust ,
        recipe:req_eternity_unbound_coins ;
    rdfs:comment "Mystic Forge recipe combining crafted Twilight and Sunrise with 5 Crystalline Dust and 10 Mystic Coins to produce a tradeable, unbound Eternity for the commercial loop."@en .

recipe:req_eternity_unbound_twilight a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:30704 ;  # Twilight
    priory:requiredQuantity 1 .

recipe:req_eternity_unbound_sunrise a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:30703 ;  # Sunrise
    priory:requiredQuantity 1 .

recipe:req_eternity_unbound_dust a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:24277 ;  # Crystalline Dust
    priory:requiredQuantity 5 .

recipe:req_eternity_unbound_coins a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:19976 ;  # Mystic Coins
    priory:requiredQuantity 10 .


# Account Bound Eternity Forge Recipe (Memory of Twilight + Memory of Sunrise + 5 Crystalline Dust + 10 Mystic Coins -> Eternity Account Bound)
recipe:recipe_forge_eternity_bound a priory:MysticForgeRecipe, priory:Recipe, owl:NamedIndividual ;
    rdfs:label "Forge Eternity (Account Bound)"@en ;
    priory:producesItem item:30689 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement
        recipe:req_eternity_bound_twilight ,
        recipe:req_eternity_bound_sunrise ,
        recipe:req_eternity_bound_dust ,
        recipe:req_eternity_bound_coins ;
    rdfs:comment "Mystic Forge recipe combining Memory of Twilight and Memory of Sunrise with 5 Crystalline Dust and 10 Mystic Coins to produce an account-bound Eternity for the Legendary Armory."@en .

recipe:req_eternity_bound_twilight a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:94875 ;  # Memory of Twilight
    priory:requiredQuantity 1 .

recipe:req_eternity_bound_sunrise a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:94917 ;  # Memory of Sunrise
    priory:requiredQuantity 1 .

recipe:req_eternity_bound_dust a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:24277 ;  # Crystalline Dust
    priory:requiredQuantity 5 .

recipe:req_eternity_bound_coins a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:19976 ;  # Mystic Coins
    priory:requiredQuantity 10 .


# ------------------------------------------------------------------------------
# 5. Invisible Bags & Safe Boxes (priory:SafeStagingBag Architecture)
# ------------------------------------------------------------------------------

item:9574 a priory:SafeStagingBag, priory:ConvenienceGizmo, priory:Item, owl:NamedIndividual ;
    rdfs:label "20 Slot Invisible Bag"@en ;
    skos:altLabel "Invisible Bag"@en,
        "20-Slot Invisible Bag"@en,
        "Invisible Bag (Tailor)"@en ;
    priory:gw2Id 9574 ;
    priory:chatCode "[&AgFmJQAA]" ;
    priory:chatLink "[&AgFmJQAA]" ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    priory:bagSlots 20 ;
    rdfs:comment "A 20-slot inventory bag crafted by Tailors whose items are hidden from vendors, immune to deposit all materials, and never affected by inventory compacting. Essential for safe staging of high-value unbound legendaries and precursors during the Eternity loop."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/20_Slot_Invisible_Bag> .

item:9594 a priory:SafeStagingBag, priory:ConvenienceGizmo, priory:Item, owl:NamedIndividual ;
    rdfs:label "20 Slot Safe Box"@en ;
    skos:altLabel "Safe Box"@en,
        "20-Slot Safe Box"@en ;
    priory:gw2Id 9594 ;
    priory:chatCode "[&AgF6JQAA]" ;
    priory:chatLink "[&AgF6JQAA]" ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    priory:bagSlots 20 ;
    rdfs:comment "A 20-slot safe box crafted by Armorsmiths whose contents will not be sold to vendors or moved during inventory sorting."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/20_Slot_Safe_Box> .

item:9584 a priory:SafeStagingBag, priory:ConvenienceGizmo, priory:Item, owl:NamedIndividual ;
    rdfs:label "20 Slot Invisible Pack"@en ;
    skos:altLabel "Invisible Pack"@en,
        "20-Slot Invisible Pack"@en ;
    priory:gw2Id 9584 ;
    priory:chatCode "[&AgFwJQAA]" ;
    priory:chatLink "[&AgFwJQAA]" ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    priory:bagSlots 20 ;
    rdfs:comment "A 20-slot invisible pack crafted by Leatherworkers whose contents are protected from accidental sale, sorting, and deposit actions."@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/20_Slot_Invisible_Pack> .
