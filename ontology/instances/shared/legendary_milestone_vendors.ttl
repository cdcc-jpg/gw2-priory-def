    priory:zoneName "Verdant Brink"@en ;
    priory:waypointName "Jaka Itzel Waypoint"@en ;
    priory:nearestWaypoint "[&BO8FAAA=]" ;
    priory:producesItem item:70797 ;
    priory:outputQuantity 1 ;
    priory:requiresCurrency currency:AirshipPart ;
    priory:requiredQuantity 250 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement, priory:CurrencyRequirement ; priory:requiresCurrency currency:AirshipPart ; priory:requiredQuantity 250 ] ,
        [ a priory:IngredientRequirement, priory:CurrencyRequirement ; priory:requiresCurrency currency:Coin ; priory:requiredQuantity 100000 ] ;
    skos:definition "Exchanges 250 Airship Parts and 10 Gold for Gift of the Fleet from the Itzel Mastery Vendor in Verdant Brink."@en .

# --- Nuhoch Mastery Vendor (Gift of the Chak / Ley Line Crystals) ---
