# --- Heart of Maguuma Map Completion (Gift of Maguuma) ---
item:path_maguuma_map_completion a priory:AchievementCollectionPath, owl:NamedIndividual ;
    rdfs:label "Heart of Maguuma Map Completion"@en ;
    priory:zoneName "Heart of Maguuma"@en ;
    priory:producesItem item:75919 ;
    priory:outputQuantity 1 ;
    skos:definition "Earned by achieving 100% map exploration across Heart of Maguuma zones (Verdant Brink, Auric Basin, Tangled Depths, Dragon's Stand)."@en .

