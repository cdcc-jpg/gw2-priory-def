@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix currency: <https://priory.gw2/ref/currency/> .

# ==============================================================================
# Legendary Milestone Vendors, NPCs, and Spatial Waypoints
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lion's Arch Central Hub (Precursors, Mystic Forge, Spirit Shards)
# ------------------------------------------------------------------------------

# --- Grandmaster Craftsman Hobbs (Precursor Collections & Volumes) ---
item:vendor_hobbs a priory:AcquisitionPath, owl:NamedIndividual ;
    rdfs:label "Grandmaster Craftsman Hobbs"@en ;
    priory:vendorNPC "Grandmaster Craftsman Hobbs"@en ;
    priory:zoneName "Lion's Arch"@en ;
    priory:waypointName "Trader's Forum Waypoint"@en ;
    priory:nearestWaypoint "[&BBAEAAA=]" ;
    skos:definition "Sells Gen 1 and Gen 2 legendary precursor crafting collection books and recipes."@en .

# --- Miyani / Mystic Forge (Ectoplasm, Spirit Shards, Clovers, Assembly) ---
item:vendor_miyani a priory:AcquisitionPath, owl:NamedIndividual ;
    rdfs:label "Miyani & Mystic Forge"@en ;
    priory:vendorNPC "Miyani"@en ;
    priory:zoneName "Lion's Arch"@en ;
    priory:waypointName "Trader's Forum Waypoint"@en ;
    priory:nearestWaypoint "[&BBAEAAA=]" ;
    skos:definition "Exchanges Spirit Shards for Bloodstone Shards, Philosopher's Stones, Mystic Crystals, and hosts the Mystic Forge."@en .

# ------------------------------------------------------------------------------
# 2. Frostgorge Sound (Icy Runestones)
# ------------------------------------------------------------------------------
item:vendor_rojan a priory:AcquisitionPath, owl:NamedIndividual ;
    rdfs:label "Rojan the Penitent"@en ;
    priory:vendorNPC "Rojan the Penitent"@en ;
    priory:zoneName "Frostgorge Sound"@en ;
    priory:waypointName "Earthshake Waypoint"@en ;
    priory:nearestWaypoint "[&BHsBAAA=]" ;
    skos:definition "Sells Icy Runestones for 1 gold each (100 needed for every Gen 1 & Gen 2 legendary weapon gift)."@en .

# ------------------------------------------------------------------------------
# 3. Heart of Thorns Masteries & Dragon's Stand
# ------------------------------------------------------------------------------

# --- Dragon's Stand Noxious Pods (Crystalline Ore) ---
item:vendor_dragons_stand a priory:RewardTrackPath, owl:NamedIndividual ;
    rdfs:label "Dragon's Stand Noxious Pods"@en ;
    priory:zoneName "Dragon's Stand"@en ;
    priory:waypointName "Pact Base Camp Waypoint"@en ;
    priory:nearestWaypoint "[&BBAIAAA=]" ;
    skos:definition "Gather Crystalline Ore from Noxious Pods across Dragon's Stand using Machetes after meta event completion."@en .

# --- Exalted Mastery Vendor (Gift of Tarir / Aurillium) ---
item:vendor_tarir a priory:VendorExchangePath, owl:NamedIndividual ;
    rdfs:label "Exalted Mastery Vendor"@en ;
    priory:vendorNPC "Exalted Mastery Vendor"@en ;
    priory:zoneName "Auric Basin"@en ;
    priory:waypointName "Forgotten City Waypoint"@en ;
    priory:nearestWaypoint "[&BNYHAAA=]" ;
    priory:producesItem item:71943 ;
    priory:outputQuantity 1 ;
    priory:requiresCurrency currency:LumpOfAurillium ;
    priory:requiredQuantity 250 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement, priory:CurrencyRequirement ; priory:requiresCurrency currency:LumpOfAurillium ; priory:requiredQuantity 250 ] ,
        [ a priory:IngredientRequirement, priory:CurrencyRequirement ; priory:requiresCurrency currency:Coin ; priory:requiredQuantity 100000 ] ;
    skos:definition "Exchanges 250 Lumps of Aurillium and 10 Gold for Gift of Tarir from the Exalted Mastery Vendor in Auric Basin."@en .

# --- Itzel Mastery Vendor (Gift of the Fleet / Airship Parts) ---
item:vendor_fleet a priory:VendorExchangePath, owl:NamedIndividual ;
    rdfs:label "Itzel Mastery Vendor"@en ;
