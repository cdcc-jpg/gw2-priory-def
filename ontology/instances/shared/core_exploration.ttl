# ==============================================================================

zone:Gen1RegionKryta a priory:ExplorationRegion, owl:NamedIndividual ;
    rdfs:label "Kryta (6 Zones: Queensdale -> Southsun/Gendarran)" ;
    priory:forGeneration "GEN1" ;
    priory:regionOrder 1 ;
    priory:zoneCount 6 ;
    priory:baseExplorationHours 3.8 ;
    priory:explorationDifficulty "Easy" ;
    priory:primaryMountRecommendation "raptor" ;
    priory:fallbackMountRecommendation "jackal" ;
    priory:strategyNotes "Mostly flat terrain; Raptor Canyon Jumping speeds up Queensdale, Kessex Hills, and Gendarran Fields." ;
    priory:startingWaypoint "Shaemoor Waypoint [&BO8AAAA=]" .

