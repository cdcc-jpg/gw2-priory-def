@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix recipe: <https://priory.gw2/id/recipe/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix discipline: <https://priory.gw2/ref/discipline/> .

# ==============================================================================
# Ascended & Daily Time-Gated Refinement DAGs
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deldrimor Steel Ingot (46738) & Lump of Mithrilium (46736)
# ------------------------------------------------------------------------------
item:46736 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Lump of Mithrilium"@en ;
    priory:gw2Id 46736 ;
    priory:hasRarity rarity:Ascended ;
    priory:isAccountBound true ;
    skos:definition "Daily time-gated metal refinement component (1 per account per day)."@en .

recipe:craft_lump_of_mithrilium a priory:CraftingRecipe, owl:NamedIndividual ;
    rdfs:label "Lump of Mithrilium Crafting"@en ;
    priory:producesItem item:46736 ;
    priory:outputQuantity 1 ;
    priory:requiresDiscipline discipline:Weaponsmith , discipline:Armorsmith ;
    priory:requiredRating 450 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19684 ; # 50 Mithril Ingot
        priory:requiredQuantity 50
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19721 ; # 1 Glob of Ectoplasm
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:46747 ; # 10 Thermocatalytic Reagent
        priory:requiredQuantity 10
    ] .

item:46738 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Deldrimor Steel Ingot"@en ;
    priory:gw2Id 46738 ;
    priory:hasRarity rarity:Ascended ;
    priory:isAccountBound false ;
    skos:definition "Ascended metal ingot used in Gen 2 legendary precursors and Ascended gear."@en .

recipe:craft_deldrimor_steel_ingot a priory:CraftingRecipe, owl:NamedIndividual ;
    rdfs:label "Deldrimor Steel Ingot Crafting"@en ;
    priory:producesItem item:46738 ;
    priory:outputQuantity 1 ;
    priory:requiresDiscipline discipline:Weaponsmith , discipline:Armorsmith ;
    priory:requiredRating 450 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:46736 ; # 1 Lump of Mithrilium
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19683 ; # 20 Iron Ingot
        priory:requiredQuantity 20
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19688 ; # 10 Steel Ingot
        priory:requiredQuantity 10
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19681 ; # 20 Darksteel Ingot
        priory:requiredQuantity 20
    ] .

