@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix recipe: <https://priory.gw2/id/recipe/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix currency: <https://priory.gw2/ref/currency/> .

# ==============================================================================
# Tier 6 Fine Crafting Materials & Acquisition Pathways
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Powerful Blood (GW2 ID: 24295)
# ------------------------------------------------------------------------------
item:24295 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Vial of Powerful Blood"@en ;
    priory:gw2Id 24295 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    priory:acquiredVia item:path_t6_volatile_magic_trophy ,
                       item:path_t6_laurel_merchant ,
                       item:path_t6_wizards_vault ,
                       item:path_t6_drizzlewood_blood ,
                       recipe:promote_potent_blood ;
    skos:definition "Tier 6 fine crafting trophy used in gifts of might, blood, and dusk/dawn precursor components."@en .

recipe:promote_potent_blood a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Mystic Forge Promotion: Powerful Blood"@en ;
    priory:producesItem item:24295 ;
    priory:outputQuantity 7 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24294 ; # 50 Potent Blood (T5)
        priory:requiredQuantity 50
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24295 ; # 1 Powerful Blood (T6)
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24277 ; # 5 Crystalline Dust
        priory:requiredQuantity 5
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19665 ; # 5 Philosopher's Stones (Spirit Shards)
        priory:requiredQuantity 5
    ] ;
    rdfs:comment "Transmutes 50 T5 Potent Blood into ~7 T6 Powerful Blood using Spirit Shards."@en .

