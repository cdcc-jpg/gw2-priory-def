# ==============================================================================
# Shared T6 Acquisition Archetypes
# ==============================================================================

# --- Volatile Magic Trophy Shipments ---
item:path_t6_volatile_magic_trophy a priory:VendorExchangePath, owl:NamedIndividual ;
    rdfs:label "Volatile Magic Trophy Shipments"@en ;
    priory:vendorNPC "Volatile Magic Collector" ;
    priory:zoneName "Dragonfall" ;
    priory:waypointName "Pact Command Waypoint" ;
    priory:nearestWaypoint "[&BNoLAAA=]" ;
    priory:requiresCurrency currency:VolatileMagic ;
    priory:requiredQuantity 250 ;
    skos:definition "Trade 250 Volatile Magic + 1 gold for a Trophy Shipment (yields ~10-15 T5/T6 materials). Most efficient T6 conversion in GW2."@en .

# --- Laurel Merchant Heavy Crafting Bags ---
item:path_t6_laurel_merchant a priory:VendorExchangePath, owl:NamedIndividual ;
    rdfs:label "Laurel Merchant (Heavy Crafting Bags)"@en ;
    priory:vendorNPC "Laurel Merchant" ;
    priory:zoneName "Lion's Arch" ;
    priory:waypointName "Sanctum Harbor Waypoint" ;
    priory:nearestWaypoint "[&BBAEAAA=]" ;
    priory:requiresCurrency currency:Laurel ;
    priory:requiredQuantity 1 ;
    skos:definition "Exchange 1 Laurel for 1 Heavy Crafting Bag (yields 3 T6 materials)."@en .

# --- Wizard's Vault Heavy Crafting Bags ---
item:path_t6_wizards_vault a priory:VendorExchangePath, owl:NamedIndividual ;
    rdfs:label "Wizard's Vault (Astral Acclaim Heavy Crafting Bags)"@en ;
    priory:requiresCurrency currency:AstralAcclaim ;
    priory:requiredQuantity 10 ;
    skos:definition "Redeem Astral Acclaim for Heavy Crafting Bags (Tier 6 materials)."@en .

# --- Drizzlewood Coast Charr Legion Tracks ---
item:path_t6_drizzlewood_blood a priory:RewardTrackPath, owl:NamedIndividual ;
    rdfs:label "Drizzlewood Coast: Blood Legion Material Track"@en ;
    priory:zoneName "Drizzlewood Coast" ;
    priory:waypointName "Base Camp Waypoint" ;
    priory:nearestWaypoint "[&BDoMAAA=]" ;
    skos:definition "Progress the Blood Legion donation track in Drizzlewood Coast for high yields of Powerful Blood and Vicious Fangs."@en .

item:path_t6_drizzlewood_iron a priory:RewardTrackPath, owl:NamedIndividual ;
    rdfs:label "Drizzlewood Coast: Iron Legion Material Track"@en ;
    priory:zoneName "Drizzlewood Coast" ;
    priory:waypointName "Base Camp Waypoint" ;
    priory:nearestWaypoint "[&BDoMAAA=]" ;
    skos:definition "Progress the Iron Legion donation track in Drizzlewood Coast for high yields of Armored Scales and Elaborate Totems."@en .

item:path_t6_drizzlewood_ash a priory:RewardTrackPath, owl:NamedIndividual ;
    rdfs:label "Drizzlewood Coast: Ash Legion Material Track"@en ;
    priory:zoneName "Drizzlewood Coast" ;
    priory:waypointName "Base Camp Waypoint" ;
    priory:nearestWaypoint "[&BDoMAAA=]" ;
    skos:definition "Progress the Ash Legion donation track in Drizzlewood Coast for high yields of Vicious Claws and Powerful Venom Sacs."@en .
