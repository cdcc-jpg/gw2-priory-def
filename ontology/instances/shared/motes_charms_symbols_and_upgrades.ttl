@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix recipe: <https://priory.gw2/id/recipe/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix discipline: <https://priory.gw2/ref/discipline/> .

# ==============================================================================
# Motes, Crystals, Charms, Symbols & Upgrade Salvage Ecosystem
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lucent Mote (89216) & Lucent Crystal (89103)
# ------------------------------------------------------------------------------
item:89216 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Lucent Mote"@en ;
    priory:gw2Id 89216 ;
    priory:hasRarity rarity:Fine ;
    priory:isAccountBound false ;
    priory:acquiredVia item:path_salvage_sigils_runes ;
    skos:definition "Basic magical component salvaged from upgrade components (runes and sigils)."@en .

item:89103 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Lucent Crystal"@en ;
    priory:gw2Id 89103 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    skos:definition "Refined magical crystal used in legendary sigils, runes, and relics."@en .

recipe:craft_lucent_crystal a priory:CraftingRecipe, owl:NamedIndividual ;
    rdfs:label "Lucent Crystal Crafting"@en ;
    priory:producesItem item:89103 ;
    priory:outputQuantity 1 ;
    priory:requiresDiscipline discipline:Artificer , discipline:Weaponsmith , discipline:Armorsmith , discipline:Tailor , discipline:Leatherworker , discipline:Huntsman ;
    priory:requiredRating 400 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:89216 ; # 10 Lucent Mote
        priory:requiredQuantity 10
    ] .

# ------------------------------------------------------------------------------
# 2. Mystic Mote (91424)
# ------------------------------------------------------------------------------
item:91424 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Mystic Mote"@en ;
    priory:gw2Id 91424 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    skos:definition "Concentrated magical mote used in Gifts of Sigils and Runes."@en .

