# ------------------------------------------------------------------------------
# 5. Salvage Archetypes
# ------------------------------------------------------------------------------
item:path_salvage_sigils_runes a priory:SalvagePath, owl:NamedIndividual ;
    rdfs:label "Salvage Runes and Sigils"@en ;
    skos:definition "Salvage unwanted green, yellow, or exotic runes/sigils using Runecrafter's or Silver-Fed Salvage-o-Matic."@en .

item:path_salvage_runes a priory:SalvagePath, owl:NamedIndividual ;
    rdfs:label "Salvage Runes for Charms"@en ;
    skos:definition "Salvage Masterwork, Rare, or Exotic Runes for Charms of Brilliance, Potence, and Skill."@en .

item:path_salvage_sigils a priory:SalvagePath, owl:NamedIndividual ;
    rdfs:label "Salvage Sigils for Symbols"@en ;
    skos:definition "Salvage Masterwork, Rare, or Exotic Sigils for Symbols of Control, Enhancement, and Pain."@en .
