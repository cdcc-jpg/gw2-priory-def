# ------------------------------------------------------------------------------
# 2. Amalgamated Gemstone (68063)
# ------------------------------------------------------------------------------
item:68063 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Amalgamated Gemstone"@en ;
    priory:gw2Id 68063 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    priory:acquiredVia recipe:forge_amalgamated_gemstones ;
    skos:definition "Composite gemstone used for Generation 2 and 3 legendaries."@en .

recipe:forge_amalgamated_gemstones a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Mystic Forge: Amalgamated Gemstone"@en ;
    priory:producesItem item:68063 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24508 ; # 10 Ruby Orb (or other crests/orbs)
        priory:requiredQuantity 10
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24516 ; # 10 Sapphire Orb
        priory:requiredQuantity 10
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24515 ; # 10 Emerald Orb
        priory:requiredQuantity 10
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24277 ; # 1 Crystalline Dust
        priory:requiredQuantity 1
    ] .

