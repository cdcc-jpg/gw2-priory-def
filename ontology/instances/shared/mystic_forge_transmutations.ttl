item:24515 a priory:UpgradeComponent, priory:Item, owl:NamedIndividual ;
    rdfs:label "Emerald Orb"@en ;
    priory:gw2Id 24515 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false .
