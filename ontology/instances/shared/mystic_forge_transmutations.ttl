@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix recipe: <https://priory.gw2/id/recipe/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .

# ==============================================================================
# Mystic Forge Transmutations (Fine Material Promotions, Cores -> Lodestones)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lodestones & Cores (Transmutation Recipes)
# ------------------------------------------------------------------------------

# --- Onyx Lodestone (24310) from Onyx Cores (24309) ---
item:24309 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Onyx Core"@en ;
    priory:gw2Id 24309 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false .

item:24310 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Onyx Lodestone"@en ;
    priory:gw2Id 24310 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false ;
    priory:acquiredVia recipe:OnyxCorePromotion, recipe:transmute_onyx_lodestone .

recipe:OnyxCorePromotion a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Mystic Forge: Onyx Core Promotion to Onyx Lodestone"@en ;
    priory:producesItem item:24310 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24309 ; # 2 Onyx Cores
        priory:requiredQuantity 2
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24277 ; # 1 Crystalline Dust
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:20795 ; # 1 Bottle of Elonian Wine
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:20796 ; # 1 Philosopher's Stone
        priory:requiredQuantity 1
    ] .

recipe:transmute_onyx_lodestone a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Mystic Forge: Onyx Lodestone Transmutation"@en ;
    priory:producesItem item:24310 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24309 ; # 2 Onyx Core
        priory:requiredQuantity 2
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24277 ; # 1 Crystalline Dust
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:20799 ; # 1 Mystic Crystal
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:20795 ; # 1 Bottle of Elonian Wine
        priory:requiredQuantity 1
    ] .

item:24277 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Pile of Crystalline Dust"@en ;
    priory:gw2Id 24277 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound false .

item:20795 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Bottle of Elonian Wine"@en ;
    priory:gw2Id 20795 ;
    priory:hasRarity rarity:Fine ;
    priory:isAccountBound true .

item:20796 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Philosopher's Stone"@en ;
    priory:gw2Id 20796 ;
    priory:hasRarity rarity:Basic ;
    priory:isAccountBound true .

item:20799 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Mystic Crystal"@en ;
    priory:gw2Id 20799 ;
    priory:hasRarity rarity:Basic ;
    priory:isAccountBound true .

