@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix currency: <https://priory.gw2/ref/currency/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix zone: <https://priory.gw2/ref/zone/> .

# ==============================================================================
# Dungeon Currencies & Gifts (Canonical ArenaNet GW2 REST API v2 Ground Truth)
# ==============================================================================

currency:69 a priory:Currency, skos:Concept, owl:NamedIndividual ;
    rdfs:label "Tales of Dungeon Delving"@en ;
    skos:prefLabel "Tales of Dungeon Delving"@en ;
    skos:notation "69" ;
    priory:gw2Id 69 ;
    skos:definition "Unified dungeon currency earned by completing dungeon explorable paths across Core Tyria."@en .

# ------------------------------------------------------------------------------
# 1. Ascalonian Catacombs -> Gift of Ascalon (ID: 19664)
# ------------------------------------------------------------------------------
zone:AscalonianCatacombs a priory:Dungeon, owl:NamedIndividual ;
    rdfs:label "Ascalonian Catacombs"@en ;
    priory:nearestWaypoint "[&BIcBAAA=]" ;
    priory:hasPath "Path 1"@en, "Path 2"@en, "Path 3"@en .

item:19664 a priory:GiftItem, priory:Item, owl:NamedIndividual ;
    rdfs:label "Gift of Ascalon"@en ;
    priory:gw2Id 19664 ;
    priory:hasRarity rarity:Legendary ;
    priory:isAccountBound true ;
    priory:acquiredVia [
        a priory:VendorExchangePath ;
        priory:requiresCurrency currency:69 ;
        priory:requiredQuantity 500 ;
        priory:vendorNPC "Dungeon Merchant"@en ;
        priory:zoneName "Lion's Arch"@en ;
        priory:nearestWaypoint "[&BBAEAAA=]" ;
        priory:targetItem item:19664
    ] .

