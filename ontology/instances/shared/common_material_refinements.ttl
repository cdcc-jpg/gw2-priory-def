# ==============================================================================
# Common Material Refinement Trees (T1 to T6 Ores, Logs, Scraps, Sections)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Metals & Ores -> Ingots
# ------------------------------------------------------------------------------

# --- Copper Ore (19697) & Bronze Ingot (19680) ---
item:19697 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Copper Ore"@en ;
    priory:gw2Id 19697 ;
    priory:hasRarity rarity:Basic ;
    priory:isAccountBound false .

item:19704 a priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Lump of Tin"@en ;
    priory:gw2Id 19704 ;
    priory:hasRarity rarity:Basic ;
    priory:isAccountBound false .

recipe:refine_bronze_ingot a priory:CraftingRecipe, owl:NamedIndividual ;
    rdfs:label "Bronze Ingot Crafting"@en ;
    priory:producesItem item:19680 ;
    priory:outputQuantity 1 ;
    priory:requiresDiscipline discipline:Weaponsmith , discipline:Armorsmith ;
    priory:requiredRating 0 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19697 ; # 2 Copper Ore
        priory:requiredQuantity 2
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19704 ; # 1 Lump of Tin
        priory:requiredQuantity 1
    ] .

