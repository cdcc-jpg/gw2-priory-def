@prefix : <https://priory.gw2/def/> .
@prefix priory: <https://priory.gw2/def/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix item: <https://priory.gw2/id/item/> .

# ==============================================================================
# COMPETITIVE ARMOR & ETERNITY RECIPES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ETERNITY (Mystic Forge Greatsword Combination)
# ------------------------------------------------------------------------------

item:30689 priory:producedBy priory:Recipe_Eternity .

priory:Recipe_Eternity a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Forge Eternity" ;
    priory:producesItem item:30689 ;  # Eternity
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement
        priory:Req_Eternity_Sunrise ,
        priory:Req_Eternity_Twilight ,
        priory:Req_Eternity_Dust ,
        priory:Req_Eternity_Stone .

priory:Req_Eternity_Sunrise a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:30703 ;  # Sunrise
    priory:requiredQuantity 1 .

priory:Req_Eternity_Twilight a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:30704 ;  # Twilight
    priory:requiredQuantity 1 .

priory:Req_Eternity_Dust a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:24277 ;  # Pile of Crystalline Dust
    priory:requiredQuantity 5 .

priory:Req_Eternity_Stone a priory:IngredientRequirement, owl:NamedIndividual ;
    priory:requiresItem item:20799 ;  # Philosopher's Stone
    priory:requiredQuantity 10 .


