        [ a priory:IngredientRequirement ; priory:requiresItem item:80894 ; priory:requiredQuantity 10 ] .  # Legendary Spike

# WvW Gift of War Prowess
item:80852 a priory:GiftItem, owl:NamedIndividual ;
