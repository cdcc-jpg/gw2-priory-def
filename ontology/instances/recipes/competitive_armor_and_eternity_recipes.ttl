# WvW Gift of War Prosperity
item:80850 a priory:GiftItem, owl:NamedIndividual ;
    rdfs:label "Gift of War Prosperity" ;
    priory:gw2Id 80850 ;
    priory:hasRarity <https://priory.gw2/ref/rarity/Legendary> ;
    priory:isAccountBound true ;
    priory:producedBy priory:Recipe_GiftOfWarProsperity .

priory:Recipe_GiftOfWarProsperity a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Forge Gift of War Prosperity" ;
    priory:producesItem item:80850 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement ; priory:requiresItem item:19675 ; priory:requiredQuantity 15 ] ,  # Mystic Clover
        [ a priory:IngredientRequirement ; priory:requiresItem item:19629 ; priory:requiredQuantity 1 ] ,  # Gift of Condensed Might (or Gift of Might)
        [ a priory:IngredientRequirement ; priory:requiresItem item:19628 ; priory:requiredQuantity 1 ] .  # Gift of Condensed Magic (or Gift of Magic)

