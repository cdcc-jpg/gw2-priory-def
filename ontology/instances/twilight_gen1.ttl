# ==============================================================================
# Twilight (Generation 1 Legendary Greatsword - GW2 ID: 30699)
# Reference: https://wiki.guildwars2.com/wiki/Twilight
# ==============================================================================

item:30699 a priory:LegendaryWeapon ;
    rdfs:label "Twilight"@en ;
    priory:gw2Id 30699 ;
    priory:chatCode "[&AgErZgAA]" ;
    priory:hasRarity rarity:Legendary ;
    priory:hasWeaponType weapon:Greatsword ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_twilight ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Twilight> .

recipe:forge_twilight a priory:MysticForgeRecipe ;
    rdfs:label "Forge Twilight"@en ;
    priory:producesItem item:30699 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:29185 ; # Dusk (Precursor)
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19626 ; # Gift of Fortune
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19627 ; # Gift of Mastery
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19658 ; # Gift of Twilight
        priory:requiredQuantity 1
    ] .

