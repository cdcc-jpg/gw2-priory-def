# ==============================================================================
# Twilight (Generation 1 Legendary Greatsword - GW2 ID: 30704)
# Reference: https://wiki.guildwars2.com/wiki/Twilight
# ==============================================================================

item:30704 a priory:LegendaryWeapon ;
    rdfs:label "Twilight"@en ;
    rdfs:comment "Generation 1 Legendary Greatsword forged in the Mystic Forge from Dusk, Gift of Mastery, Gift of Fortune, and Gift of Twilight."@en ;
    priory:gw2Id 30704 ;
    priory:chatCode "[&AgErZgAA]" ;
    priory:hasRarity rarity:Legendary ;
    priory:hasWeaponType weapon:Greatsword ;
    priory:armoryMaxCap 1 ;
    priory:isAccountBound true ;
    priory:playsRole role:EquippedGear ;
    priory:producedBy recipe:forge_twilight ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Twilight> .

recipe:forge_twilight a priory:MysticForgeRecipe ;
    rdfs:label "Forge Twilight"@en ;
    priory:producesItem item:30704 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:29185 ; # Dusk (Precursor)
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19626 ; # Gift of Fortune
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19674 ; # Gift of Mastery
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19648 ; # Gift of Twilight
        priory:requiredQuantity 1
    ] .

# ------------------------------------------------------------------------------
# 1. Precursor: Dusk (GW2 ID: 29185)
# ------------------------------------------------------------------------------
item:29185 a priory:PrecursorWeapon ;
    rdfs:label "Dusk"@en ;
    rdfs:comment "Generation 1 Exotic Greatsword precursor required to forge Twilight."@en ;
    priory:isPrecursorOf item:30704 ;
    priory:gw2Id 29185 ;
    priory:chatCode "[&AgEpZgAA]" ;
    priory:hasRarity rarity:Exotic ;
    priory:hasWeaponType weapon:Greatsword ;
    priory:isAccountBound false ;
    priory:playsRole role:Precursor, role:EquippedGear ;
    priory:hasSubstituteSource [ a priory:TradingPostPurchasePath ] ,
                               [ a priory:AchievementCollectionPath ] ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Dusk> .

