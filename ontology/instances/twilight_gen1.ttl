        priory:requiredQuantity 77
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19721 ; # Glob of Ectoplasm
        priory:requiredQuantity 250
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19628 ; # Gift of Magic
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19629 ; # Gift of Might
        priory:requiredQuantity 1
    ] .

