# --- Sub-ingredients, T6 Gifts, and Vendor Currencies (with Spatial Waypoints) ---

item:19675 a priory:CraftingMaterial ;
    rdfs:label "Mystic Clover"@en ;
    priory:gw2Id 19675 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound true ;
    priory:hasSubstituteSource [
        a priory:VendorExchangePath ;
        priory:requiresCurrency currency:AstralAcclaim ;
        priory:requiredQuantity 60 ;
        rdfs:label "Wizard's Vault Astral Rewards"@en
    ] , [
        a priory:VendorExchangePath ;
        priory:requiresCurrency currency:FractalRelic ;
        priory:requiredQuantity 150 ;
        priory:vendorNPC "BUY-2046"@en ;
        priory:zoneName "Mistlock Sanctuary / Fractals of the Mists"@en ;
        priory:hasTimeGate [ a priory:TimeGate ; rdfs:label "2 per day"@en ]
    ] , [
        a priory:RewardTrackPath ;
        priory:hasGameMode gamemode:WvWRewardTrack ;
        rdfs:label "WvW Non-Repeatable Reward Tracks"@en
    ] .

item:19674 a priory:CraftingMaterial ;
    rdfs:label "Bloodstone Shard"@en ;
    priory:gw2Id 19674 ;
    priory:hasRarity rarity:Exotic ;
    priory:isAccountBound true ;
    priory:acquiredVia [
        a priory:VendorExchangePath ;
        priory:requiresCurrency currency:SpiritShard ;
        priory:requiredQuantity 200 ;
        priory:vendorNPC "Miyani (Mystic Forge)"@en ;
        priory:zoneName "Lion's Arch"@en ;
        priory:waypointName "Trader's Forum Waypoint"@en ;
        priory:nearestWaypoint "[&BBAEAAA=]"
    ] .

item:18845 a priory:CraftingMaterial ;
    rdfs:label "Icy Runestone"@en ;
    priory:gw2Id 18845 ;
    priory:hasRarity rarity:Rare ;
    priory:isAccountBound true ;
    priory:acquiredVia [
        a priory:VendorExchangePath ;
        priory:requiresCurrency currency:Coin ;
        priory:requiredQuantity 10000 ; # 1 gold = 10000 copper
        priory:vendorNPC "Rojan the Penitent"@en ;
        priory:zoneName "Frostgorge Sound"@en ;
        priory:waypointName "Earthshake Waypoint"@en ;
        priory:nearestWaypoint "[&BHsBAAA=]"
    ] .

item:19925 a priory:CraftingMaterial ;
    rdfs:label "Obsidian Shard"@en ;
    priory:gw2Id 19925 ;
    priory:hasRarity rarity:Fine ;
    priory:isAccountBound true ;
    priory:acquiredVia [
        a priory:VendorExchangePath ;
        priory:requiresCurrency currency:Karma ;
        priory:requiredQuantity 2100 ;
        priory:vendorNPC "Tactician Deathspark"@en ;
        priory:zoneName "Straits of Devastation"@en ;
        priory:waypointName "Glorious Victory Waypoint"@en ;
        priory:nearestWaypoint "[&BO4CAAA=]"
    ] .

item:19677 a priory:GiftItem ;
    rdfs:label "Gift of Exploration"@en ;
    priory:gw2Id 19677 ;
    priory:hasRarity rarity:Legendary ;
    priory:isAccountBound true ;
    priory:acquiredVia [
        a priory:AchievementCollectionPath ;
        priory:hasGameMode gamemode:MapCompletion ;
        rdfs:label "100% Core Tyria Map Completion"@en
    ] .

item:19678 a priory:GiftItem ;
    rdfs:label "Gift of Battle"@en ;
    priory:gw2Id 19678 ;
    priory:hasRarity rarity:Legendary ;
    priory:isAccountBound true ;
    priory:acquiredVia [
        a priory:RewardTrackPath ;
        priory:hasGameMode gamemode:WvWRewardTrack ;
        rdfs:label "Gift of Battle WvW Reward Track"@en
    ] .

# --- Crafting Recipes for T6 / Discipline Gifts ---

item:19641 a priory:GiftItem ;
    rdfs:label "Gift of Metal"@en ;
