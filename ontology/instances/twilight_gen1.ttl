@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix priory-ref: <https://priory.gw2/ref/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix weapon: <https://priory.gw2/ref/weapon/> .
@prefix discipline: <https://priory.gw2/ref/discipline/> .
@prefix gamemode: <https://priory.gw2/ref/gamemode/> .
@prefix currency: <https://priory.gw2/ref/currency/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix recipe: <https://priory.gw2/id/recipe/> .

# ==============================================================================
# Twilight (Generation 1 Legendary Greatsword)
# ==============================================================================

item:30699 a priory:LegendaryWeapon ;
    rdfs:label "Twilight"@en ;
    priory:gw2Id 30699 ;
    priory:chatCode "[&AgErZgAA]" ;
    priory:hasRarity rarity:Legendary ;
    priory:hasWeaponType weapon:Greatsword ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_twilight ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Twilight> .

recipe:forge_twilight a priory:MysticForgeRecipe ;
    rdfs:label "Forge Twilight"@en ;
    priory:producesItem item:30699 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:29185 ; # Dusk
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19626 ; # Gift of Fortune
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19627 ; # Gift of Mastery
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19658 ; # Gift of Twilight
        priory:requiredQuantity 1
    ] .

# --- Component 1: Dusk (Precursor) ---
item:29185 a priory:PrecursorWeapon ;
    rdfs:label "Dusk"@en ;
    priory:gw2Id 29185 ;
    priory:chatCode "[&AgEpZgAA]" ;
    priory:hasRarity rarity:Exotic ;
    priory:hasWeaponType weapon:Greatsword ;
    priory:isAccountBound false ;
    priory:hasSubstituteSource [ a priory:TradingPostPurchasePath ] ,
                               [ a priory:AchievementCollectionPath ] ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Dusk> .

# --- Component 2: Gift of Fortune ---
item:19626 a priory:GiftItem ;
