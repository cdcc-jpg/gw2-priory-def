@prefix priory: <https://priory.gw2/def/> .
@prefix role: <https://priory.gw2/ref/role/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix recipe: <https://priory.gw2/id/recipe/> .
@prefix currency: <https://priory.gw2/ref/currency/> .
@prefix weapon: <https://priory.gw2/ref/weapon/> .
@prefix slot: <https://priory.gw2/ref/slot/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# GENERATION 3: AURENE LEGENDARY WEAPONS, DRAGON VARIANTS & TOKENS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Key Tokens & Materials
# ------------------------------------------------------------------------------

# Antique Summoning Stone
item:96978 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Antique Summoning Stone"@en ;
    priory:gw2Id 96978 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient, role:MarketCommodity, role:CurrencyExchange ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound false ;
    priory:hasTimeGate [
        a priory:TimeGate ;
        priory:weeklyLimit 5 ;
        priory:vendorNPC "Leivas"@en ;
        priory:nearestWaypoint "[&BEwMAAA=]" ;
        priory:zoneName "Arborstone"@en
    ] ;
    priory:acquiredVia item:vendor_leivas_ass ;
    skos:altLabel "ASS"@en, "Summoning Stone"@en ;
    skos:definition "Key End of Dragons crafting component used in Generation 3 legendary weapons and tributes. Limited to 5 purchases per account per calendar week from NPC Leivas in Arborstone ([&BEwMAAA=])."@en .

# Augment existing Leivas vendor path from time_gates_and_caps.ttl
item:vendor_leivas_ass priory:grantsItem item:96978 .

# Chunk of Pure Jade
item:96979 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Chunk of Pure Jade"@en ;
    priory:gw2Id 96979 ;
    priory:hasRarity rarity:Rare ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    skos:altLabel "Pure Jade Chunk"@en, "Pure Jade"@en ;
    skos:definition "Concentrated pure dragonjade mined across Canthan regions, used in crafting the Gift of the Dragon Empire and Gen 3 components."@en .

# Ambergris / Chunk of Ancient Ambergris
item:96347 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Chunk of Ancient Ambergris"@en ;
    skos:altLabel "Ambergris"@en, "Ancient Ambergris"@en ;
    priory:gw2Id 96347 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient, role:MarketCommodity ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound false ;
    skos:definition "High-value tradeable fishing commodity and crafting component required for Gen 3 weapons, Gift of Cantha, and Dragon Empire gifts."@en .

# Memories of Aurene
item:96074 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Memory of Aurene"@en ;
    skos:altLabel "Memories of Aurene"@en ;
    priory:gw2Id 96074 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound false ;
    skos:definition "Crystallized memories of the Prismatic Elder Dragon, Aurene. Acquired through End of Dragons events, strikes, and dragon metas; used for Gen 3 weapons and Elder Dragon variant skins."@en .

# Jade Runestone
item:96590 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Jade Runestone"@en ;
    priory:gw2Id 96590 ;
    priory:hasRarity rarity:Rare ;
    priory:playsRole role:CraftingIngredient, role:MarketCommodity ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound false ;
    skos:definition "Tradeable Canthan runestone discovered in Echovald Wilds and Dragon's End chests, utilized in Gift of Cantha and legendary weapon gifts."@en .

# ------------------------------------------------------------------------------
# 2. Canthan Legendary Gifts
# ------------------------------------------------------------------------------

# Gift of Cantha
item:97099 a priory:GiftItem, priory:ContainerizedToken, owl:NamedIndividual ;
    rdfs:label "Gift of Cantha"@en ;
    priory:gw2Id 97099 ;
    priory:hasRarity rarity:Legendary ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_gift_of_cantha ;
    skos:definition "End of Dragons regional gift combining Imperial Favor, Antique Summoning Stones, Jade Runestones, and Ambergris."@en .

recipe:forge_gift_of_cantha a priory:Recipe, owl:NamedIndividual ;
    rdfs:label "Forge Gift of Cantha"@en ;
    priory:vendorNPC "Leivas"@en ;
    priory:zoneName "Arborstone"@en ;
    priory:outputQuantity 1 ;
    priory:producesItem item:97099 ;
    priory:hasCostRequirement
        [ a priory:CostRequirement ; priory:requiresCurrency currency:ImperialFavor ; priory:requiredQuantity 2500 ] , # Imperial Favor
        [ a priory:CostRequirement ; priory:requiresItem item:96978 ; priory:requiredQuantity 100 ] ,      # Antique Summoning Stones
        [ a priory:CostRequirement ; priory:requiresItem item:96590 ; priory:requiredQuantity 100 ] ,      # Jade Runestones
        [ a priory:CostRequirement ; priory:requiresItem item:96347 ; priory:requiredQuantity 100 ] .     # Chunk of Ancient Ambergris

# Gift of the Dragon Empire
item:96894 a priory:GiftItem, priory:ContainerizedToken, owl:NamedIndividual ;
    rdfs:label "Gift of the Dragon Empire"@en ;
    priory:gw2Id 96894 ;
    priory:hasRarity rarity:Legendary ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_gift_of_the_dragon_empire ;
    skos:definition "Empire-wide legendary gift combining Gift of Cantha, Chunks of Pure Jade, Memories of Aurene, and Jade Runestones."@en .

recipe:forge_gift_of_the_dragon_empire a priory:Recipe, owl:NamedIndividual ;
    rdfs:label "Forge Gift of the Dragon Empire"@en ;
    priory:vendorNPC "Leivas"@en ;
    priory:zoneName "Arborstone"@en ;
    priory:outputQuantity 1 ;
    priory:producesItem item:96894 ;
    priory:hasCostRequirement
        [ a priory:CostRequirement ; priory:requiresItem item:97099 ; priory:requiredQuantity 1 ] ,   # Gift of Cantha
        [ a priory:CostRequirement ; priory:requiresItem item:96979 ; priory:requiredQuantity 100 ] , # Chunk of Pure Jade
        [ a priory:CostRequirement ; priory:requiresItem item:96074 ; priory:requiredQuantity 250 ] , # Memories of Aurene
        [ a priory:CostRequirement ; priory:requiresItem item:96590 ; priory:requiredQuantity 100 ] . # Jade Runestone

# Gift of Aurene
item:95797 a priory:GiftItem, priory:ContainerizedToken, owl:NamedIndividual ;
    rdfs:label "Gift of Aurene"@en ;
    priory:gw2Id 95797 ;
    priory:hasRarity rarity:Legendary ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:isAccountBound true ;
    skos:definition "Prismatic tribute gift combining Mystic Clovers, Ectoplasm, Runestones, and Memories of Aurene."@en .

