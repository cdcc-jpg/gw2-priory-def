@prefix priory: <https://priory.gw2/def/> .
@prefix role: <https://priory.gw2/ref/role/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix recipe: <https://priory.gw2/id/recipe/> .
@prefix currency: <https://priory.gw2/ref/currency/> .
@prefix armor: <https://priory.gw2/ref/armor/> .
@prefix slot: <https://priory.gw2/ref/slot/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# SECRETS OF THE OBSCURE: OBSIDIAN LEGENDARY ARMOR & ESSENCES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Rift Essences (Wallet Currencies & Refined Materials)
# ------------------------------------------------------------------------------

# Essence of Despair (Fine Rift Essence - Tier 1)
currency:78 a priory:Currency, priory:AccountWalletScalar, owl:NamedIndividual ;
    rdfs:label "Essence of Despair"@en ;
    skos:prefLabel "Essence of Despair"@en ;
    skos:altLabel "Fine Rift Essence"@en, "T1 Rift Essence"@en, "T1 Kryptis Essence"@en, "Despair Essence"@en ;
    priory:apiWalletId 78 ;
    priory:gw2Id 78 ;
    priory:hasRarity rarity:Fine ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized false ;
    skos:definition "Tier 1 rift essence obtained from Tier 1 Rift Hunting and Convergences across Tyria and Secrets of the Obscure maps."@en ;
    owl:sameAs currency:EssenceOfDespair .

currency:EssenceOfDespair a owl:NamedIndividual ;
    owl:sameAs currency:78 .

# Essence of Greed (Masterwork Rift Essence - Tier 2)
currency:80 a priory:Currency, priory:AccountWalletScalar, owl:NamedIndividual ;
    rdfs:label "Essence of Greed"@en ;
    skos:prefLabel "Essence of Greed"@en ;
    skos:altLabel "Masterwork Rift Essence"@en, "T2 Rift Essence"@en, "T2 Kryptis Essence"@en, "Greed Essence"@en ;
    priory:apiWalletId 80 ;
    priory:gw2Id 80 ;
    priory:hasRarity rarity:Masterwork ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized false ;
    skos:definition "Tier 2 rift essence obtained from Tier 2 Rift Hunting and Convergences using Common Kryptis Motivations."@en ;
    owl:sameAs currency:EssenceOfGreed .

currency:EssenceOfGreed a owl:NamedIndividual ;
    owl:sameAs currency:80 .

# Essence of Triumph (Rare Rift Essence - Tier 3)
currency:79 a priory:Currency, priory:AccountWalletScalar, owl:NamedIndividual ;
    rdfs:label "Essence of Triumph"@en ;
    skos:prefLabel "Essence of Triumph"@en ;
    skos:altLabel "Rare Rift Essence"@en, "T3 Rift Essence"@en, "T3 Kryptis Essence"@en, "Triumph Essence"@en ;
    priory:apiWalletId 79 ;
    priory:gw2Id 79 ;
    priory:hasRarity rarity:Rare ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized false ;
    skos:definition "Tier 3 rift essence obtained from Tier 3 Rift Hunting and Convergences using Greater Kryptis Motivations."@en ;
    owl:sameAs currency:EssenceOfTriumph .

currency:EssenceOfTriumph a owl:NamedIndividual ;
    owl:sameAs currency:79 .

# Amalgamated Rift Essence (Composite Component)
item:100930 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Amalgamated Rift Essence"@en ;
    skos:altLabel "Amalgamated Kryptis Essence"@en ;
    priory:gw2Id 100930 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_amalgamated_rift_essence ;
    skos:definition "Composite rift essence refined from 250 Essence of Despair, 100 Essence of Greed, 50 Essence of Triumph, and 50 Globs of Ectoplasm."@en .

recipe:forge_amalgamated_rift_essence a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Forge Amalgamated Rift Essence"@en ;
    priory:outputQuantity 1 ;
    priory:producesItem item:100930 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement ; priory:requiresCurrency currency:78 ; priory:requiredQuantity 250 ] , # Essence of Despair (T1)
        [ a priory:IngredientRequirement ; priory:requiresCurrency currency:80 ; priory:requiredQuantity 100 ] , # Essence of Greed (T2)
        [ a priory:IngredientRequirement ; priory:requiresCurrency currency:79 ; priory:requiredQuantity 50 ] ,  # Essence of Triumph (T3)
        [ a priory:IngredientRequirement ; priory:requiresItem item:19721 ; priory:requiredQuantity 50 ] ;   # Glob of Ectoplasm
    owl:sameAs recipe:forge_amalgamated_kryptis_essence .

recipe:forge_amalgamated_kryptis_essence a owl:NamedIndividual ;
    owl:sameAs recipe:forge_amalgamated_rift_essence .

# Purified Rift Essence (Intermediate Refined Component)
item:100569 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Purified Rift Essence"@en ;
    skos:altLabel "Purified Kryptis Essence"@en ;
    priory:gw2Id 100569 ;
    priory:hasRarity rarity:Ascended ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_purified_rift_essence ;
    skos:definition "Intermediate purified essence refined from 1 Amalgamated Rift Essence and 1 Mystic Clover."@en .

recipe:forge_purified_rift_essence a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Forge Purified Rift Essence"@en ;
    priory:outputQuantity 1 ;
    priory:producesItem item:100569 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement ; priory:requiresItem item:100930 ; priory:requiredQuantity 1 ] , # Amalgamated Rift Essence
        [ a priory:IngredientRequirement ; priory:requiresItem item:19675 ; priory:requiredQuantity 1 ] ;  # Mystic Clover
    owl:sameAs recipe:forge_purified_kryptis_essence .

recipe:forge_purified_kryptis_essence a owl:NamedIndividual ;
    owl:sameAs recipe:forge_purified_rift_essence .

# ------------------------------------------------------------------------------
# 2. Regional Expansion Gifts & Map Currencies (Secrets of the Obscure)
# ------------------------------------------------------------------------------

# Regional Map Materials / Currencies
item:100267 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Case of Captured Lightning"@en ;
    skos:altLabel "Captured Lightning"@en, "Skywatch Map Currency"@en ;
    priory:gw2Id 100267 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    skos:definition "SotO regional currency gathered from Skywatch Archipelago meta-events and chests."@en .

item:99964 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Pouch of Stardust"@en ;
    skos:altLabel "Stardust"@en, "Amnytas Map Currency"@en, "Pinch of Stardust"@en ;
    priory:gw2Id 99964 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    skos:definition "SotO regional currency gathered from the Amnytas meta-event and bastions."@en .

item:100098 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Clot of Congealed Screams"@en ;
    skos:altLabel "Congealed Screams"@en, "Inner Nayos Map Currency"@en, "Clotted Scream"@en ;
    priory:gw2Id 100098 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    skos:definition "SotO regional currency harvested in Inner Nayos and Kryptis rifts."@en .

# Gift of Amnytas
item:100798 a priory:GiftItem, priory:ContainerizedToken, owl:NamedIndividual ;
    rdfs:label "Gift of Amnytas"@en ;
    priory:gw2Id 100798 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:isAccountBound true ;
    skos:definition "Regional gift component awarded for Amnytas map exploration and achievements."@en .

# Gift of the Astral Ward
item:100466 a priory:GiftItem, priory:ContainerizedToken, owl:NamedIndividual ;
    rdfs:label "Gift of the Astral Ward"@en ;
    priory:gw2Id 100466 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_gift_of_the_astral_ward ;
    skos:definition "Secrets of the Obscure legendary armor gift combining regional map gifts including Gift of Amnytas and regional currencies."@en .

recipe:forge_gift_of_the_astral_ward a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Forge Gift of the Astral Ward"@en ;
    priory:outputQuantity 1 ;
    priory:producesItem item:100466 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement ; priory:requiresItem item:100798 ; priory:requiredQuantity 1 ] ,   # Gift of Amnytas
        [ a priory:IngredientRequirement ; priory:requiresItem item:100267 ; priory:requiredQuantity 5 ] ,   # Case of Captured Lightning
        [ a priory:IngredientRequirement ; priory:requiresItem item:99964 ; priory:requiredQuantity 5 ] ,    # Pouch of Stardust
        [ a priory:IngredientRequirement ; priory:requiresItem item:100098 ; priory:requiredQuantity 5 ] ;   # Clot of Congealed Screams
    owl:sameAs recipe:forge_gift_of_astral_possession, recipe:forge_gift_of_the_celestial .

recipe:forge_gift_of_astral_possession a owl:NamedIndividual ;
    owl:sameAs recipe:forge_gift_of_the_astral_ward .

recipe:forge_gift_of_the_celestial a owl:NamedIndividual ;
    owl:sameAs recipe:forge_gift_of_the_astral_ward .

