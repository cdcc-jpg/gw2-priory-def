# ------------------------------------------------------------------------------
# 4. Heavy Obsidian Legendary Armor
# ------------------------------------------------------------------------------

item:101544 a priory:HeavyArmor, priory:LegendaryArmor, priory:ManifestedArtifact, priory:ContainerizedToken, owl:NamedIndividual ;
    rdfs:label "Obsidian Heavy Helmet"@en ;
    skos:altLabel "Obsidian Heavy Helm"@en, "Obsidian Helm"@en, "Open World Heavy Helm"@en, "SotO Heavy Helm"@en ;
    priory:gw2Id 101544 ;
    priory:hasArmorWeight armor:HeavyArmor ;
    priory:hasEquipmentSlot slot:Helm ;
    priory:hasRarity rarity:Legendary ;
    priory:playsRole role:EquippedGear ;
    priory:isContainerized true ;
    priory:isEquipable true ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_obsidian_heavy_helmet .

recipe:forge_obsidian_heavy_helmet a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Forge Obsidian Heavy Helmet"@en ;
    priory:outputQuantity 1 ;
    priory:producesItem item:101544 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement ; priory:requiresItem item:100026 ; priory:requiredQuantity 1 ] ,  # Astral Ward Heavy Helm
        [ a priory:IngredientRequirement ; priory:requiresItem item:100466 ; priory:requiredQuantity 1 ] ,  # Gift of the Astral Ward
        [ a priory:IngredientRequirement ; priory:requiresItem item:100798 ; priory:requiredQuantity 1 ] ,  # Gift of Amnytas
        [ a priory:IngredientRequirement ; priory:requiresItem item:100569 ; priory:requiredQuantity 5 ] ; # Purified Rift Essence
    owl:sameAs recipe:forge_obsidian_helm .

recipe:forge_obsidian_helm a owl:NamedIndividual ;
    owl:sameAs recipe:forge_obsidian_heavy_helmet .

