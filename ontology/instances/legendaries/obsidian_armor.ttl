@prefix priory: <https://priory.gw2/def/> .
@prefix role: <https://priory.gw2/ref/role/> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix recipe: <https://priory.gw2/id/recipe/> .
@prefix currency: <https://priory.gw2/ref/currency/> .
@prefix armor: <https://priory.gw2/ref/armor/> .
@prefix slot: <https://priory.gw2/ref/slot/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# SECRETS OF THE OBSCURE: OBSIDIAN LEGENDARY ARMOR & ESSENCES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kryptis Essences & Composite Materials
# ------------------------------------------------------------------------------

# Essence of Despair (Tier 1)
item:100849 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Essence of Despair"@en ;
    priory:gw2Id 100849 ;
    priory:hasRarity rarity:Fine ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    skos:altLabel "T1 Kryptis Essence"@en, "Despair Essence"@en ;
    skos:definition "Tier 1 Kryptis essence obtained from Tier 1 Rift Hunting across Tyria and Secrets of the Obscure maps."@en .

# Essence of Greed (Tier 2)
item:100429 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Essence of Greed"@en ;
    priory:gw2Id 100429 ;
    priory:hasRarity rarity:Masterwork ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    skos:altLabel "T2 Kryptis Essence"@en, "Greed Essence"@en ;
    skos:definition "Tier 2 Kryptis essence obtained from Tier 2 Rift Hunting using Common Kryptis Motivations."@en .

# Essence of Triumph (Tier 3)
item:100148 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Essence of Triumph"@en ;
    priory:gw2Id 100148 ;
    priory:hasRarity rarity:Rare ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    skos:altLabel "T3 Kryptis Essence"@en, "Triumph Essence"@en ;
    skos:definition "Tier 3 Kryptis essence obtained from Tier 3 Rift Hunting using Greater Kryptis Motivations."@en .

# Purified Kryptis Essence (Intermediate Forged Component)
item:101180 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Purified Kryptis Essence"@en ;
    priory:gw2Id 101180 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_purified_kryptis_essence ;
    skos:definition "Intermediate purified essence forged from 250 Essence of Despair, 100 Essence of Greed, 50 Essence of Triumph, and 1 Glob of Ectoplasm."@en .

recipe:forge_purified_kryptis_essence a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Forge Purified Kryptis Essence"@en ;
    priory:outputQuantity 1 ;
    priory:producesItem item:101180 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement ; priory:requiresItem item:100849 ; priory:requiredQuantity 250 ] , # Essence of Despair (T1)
        [ a priory:IngredientRequirement ; priory:requiresItem item:100429 ; priory:requiredQuantity 100 ] , # Essence of Greed (T2)
        [ a priory:IngredientRequirement ; priory:requiresItem item:100148 ; priory:requiredQuantity 50 ] ,  # Essence of Triumph (T3)
        [ a priory:IngredientRequirement ; priory:requiresItem item:19721 ; priory:requiredQuantity 1 ] .   # Glob of Ectoplasm

# Amalgamated Kryptis Essence (Composite Component)
item:101269 a priory:ContainerizedToken, priory:CraftingMaterial, owl:NamedIndividual ;
    rdfs:label "Amalgamated Kryptis Essence"@en ;
    priory:gw2Id 101269 ;
    priory:hasRarity rarity:Exotic ;
    priory:playsRole role:CraftingIngredient ;
    priory:isContainerized true ;
    priory:maxStackSize 250 ;
    priory:isAccountBound true ;
    priory:producedBy recipe:forge_amalgamated_kryptis_essence ;
    skos:definition "High-tier composite Kryptis essence utilized in forging Obsidian Armor gifts and Astral components."@en .

recipe:forge_amalgamated_kryptis_essence a priory:MysticForgeRecipe, owl:NamedIndividual ;
    rdfs:label "Forge Amalgamated Kryptis Essence"@en ;
    priory:outputQuantity 1 ;
    priory:producesItem item:101269 ;
    priory:hasIngredientRequirement
        [ a priory:IngredientRequirement ; priory:requiresItem item:101180 ; priory:requiredQuantity 1 ] ,  # Purified Kryptis Essence
        [ a priory:IngredientRequirement ; priory:requiresItem item:19721 ; priory:requiredQuantity 60 ] ,  # Glob of Ectoplasm
        [ a priory:IngredientRequirement ; priory:requiresItem item:68063 ; priory:requiredQuantity 5 ] ,   # Amalgamated Gemstone
        [ a priory:IngredientRequirement ; priory:requiresItem item:19675 ; priory:requiredQuantity 2 ] .   # Mystic Clover

