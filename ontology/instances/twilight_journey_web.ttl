# -----------------------------------------------------------------------------
# SECTION 8: GIFT OF TWILIGHT — CRAFTING DISCIPLINES & LODESTONES
# -----------------------------------------------------------------------------

# 8A. Gift of Metal (Weaponsmith 400)
item:GiftOfMetal_Comment a rdf:Statement ;
    rdf:subject recipe:GiftOfMetal ;
    rdf:predicate rdfs:comment ;
    rdf:object "Leveling Weaponsmith from 0 to 400 costs approximately 15-25 gold using crafting guides (gw2crafts.net). Crafting stations in Black Citadel [&BKgDAAA=], Lion's Arch [&BBAEAAA=]." .

# 8B. Gift of Darkness (Armorsmith 400)
item:GiftOfDarkness_Comment a rdf:Statement ;
    rdf:subject recipe:GiftOfDarkness ;
    rdf:predicate rdfs:comment ;
    rdf:object "Leveling Armorsmith from 0 to 400 costs approximately 15-25 gold using crafting guides (gw2crafts.net). Crafting stations in Black Citadel [&BKgDAAA=], Lion's Arch [&BBAEAAA=]." .

# 8C. Icy Runestones
item:20799_Comment a rdf:Statement ;
    rdf:subject item:20799 ;
    rdf:predicate rdfs:comment ;
    rdf:object "100 needed, purchased for 1 gold each (100 gold total). Significant flat gold sink." .

# 8D. Onyx Lodestones
item:24310_TradingPostPath a priory:TradingPostPurchasePath ;
    rdfs:label "Trading Post Purchase of Onyx Lodestone" ;
    priory:targetItem item:24310 ;
    rdfs:comment "Direct purchase, expensive." .

recipe:OnyxCorePromotion a priory:MysticForgeRecipe ;
    rdfs:label "Mystic Forge: Onyx Core Promotion to Onyx Lodestone" ;
    priory:producesItem item:24310 ;
    priory:outputQuantity 1 ;
    priory:hasIngredientRequirement [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24309 ; # 2 Onyx Cores
        priory:requiredQuantity 2
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:24277 ; # 1 Crystalline Dust
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19663 ; # 1 Bottle of Elonian Wine
        priory:requiredQuantity 1
    ] , [
        a priory:IngredientRequirement ;
        priory:requiresItem item:19665 ; # 1 Philosopher's Stone
        priory:requiredQuantity 1
    ] ;
    rdfs:comment "2 Onyx Cores + 1 Crystalline Dust + 1 Bottle of Elonian Wine + 1 Philosopher's Stone -> 1 Onyx Lodestone." .

recipe:OnyxLodestoneForge a priory:MysticForgeRecipe ;
    rdfs:label "Onyx Lodestone Forge Promotion" ;
    priory:producesItem item:24310 ;
    priory:outputQuantity 1 ;
    rdfs:comment "2 Onyx Cores + 1 Crystal + 1 Bottle of Elonian Wine + 1 Philosopher's Stone -> 1 Onyx Lodestone." .

item:24310_TwilightArborPath a priory:OpenWorldFarmPath ;
    rdfs:label "Twilight Arbor (Aetherpath) Farm" ;
    priory:targetItem item:24310 ;
    priory:zoneName "Caledon Forest" ;
    priory:nearestWaypoint "[&BEEFAAA=]" ;
    rdfs:comment "Aetherpath drops Onyx Cores." .

item:24310_CrucibleOfEternityPath a priory:OpenWorldFarmPath ;
    rdfs:label "Crucible of Eternity Farm" ;
    priory:targetItem item:24310 ;
    priory:zoneName "Mount Maelstrom" ;
    priory:nearestWaypoint "[&BDoCAAA=]" ;
    rdfs:comment "Drops Onyx Cores/Lodestones." .

item:24310_OrrFarmPath a priory:OpenWorldFarmPath ;
    rdfs:label "Orr Risen Farm" ;
    priory:targetItem item:24310 ;
    priory:zoneName "Ruins of Orr" ;
    rdfs:comment "Risen enemies in Orr drop Onyx Cores." .

# 8E. Superior Sigil of Force
item:24615_Comment a rdf:Statement ;
    rdf:subject item:24615 ;
    rdf:predicate rdfs:comment ;
    rdf:object "Can be purchased from Trading Post or salvaged from Exotic weapons." .

# -----------------------------------------------------------------------------
# SECTION 9: ECTOPLASM ECONOMY
# -----------------------------------------------------------------------------

item:19721_SalvagePath a priory:AcquisitionPath ;
    rdfs:label "Salvaging Rare Equipment" ;
    priory:targetItem item:19721 ;
    rdfs:comment "Salvaging Rare (level 68+) equipment with Mystic/Silver-Fed Salvage Kit." .

item:19721_TradingPostPath a priory:TradingPostPurchasePath ;
    rdfs:label "Trading Post Purchase of Ectoplasm" ;
    priory:targetItem item:19721 ;
    rdfs:comment "Direct purchase from the Trading Post." .

item:19721_SilverwastesPath a priory:OpenWorldFarmPath ;
    rdfs:label "Silverwastes RIBA Meta Farm for Ectos" ;
    priory:targetItem item:19721 ;
    priory:zoneName "The Silverwastes" ;
    priory:nearestWaypoint "[&BF8HAAA=]" ;
    rdfs:comment "Rare drops from champion bags during the meta." .

recipe:EctoGamble a priory:MysticForgeRecipe ;
    rdfs:label "Mystic Forge Ecto Gamble" ;
    priory:producesItem item:19721 ;
    priory:outputQuantity 1 ;
    rdfs:comment "NOT recommended." .

# -----------------------------------------------------------------------------
# SECTION 10: FINAL ASSEMBLY AT MYSTIC FORGE
# -----------------------------------------------------------------------------

recipe:TwilightFinalAssembly a priory:MysticForgeRecipe, owl:NamedIndividual ;
    owl:sameAs recipe:forge_twilight ;
    rdfs:label "Twilight Final Assembly" ;
    priory:producesItem item:30704 ;
    priory:outputQuantity 1 ;
    priory:zoneName "Lion's Arch" ;
    priory:nearestWaypoint "[&BBAEAAA=]" ;
    rdfs:comment "Insert: Dusk + Gift of Fortune + Gift of Mastery + Gift of Twilight at the Mystic Forge. The ceremonial final moment to craft Twilight." .
