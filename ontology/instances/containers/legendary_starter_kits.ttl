# ==============================================================================
# Acquisition Pathway Individuals (Container Unpack Routes)
# ==============================================================================

# Unpack Set 2 Routes (The Moot, The Predator, Quip, Meteorlogicus)
item:29166 priory:acquiredVia item:unpack_set2_moot .
item:19642 priory:acquiredVia item:unpack_set2_moot .

item:29173 priory:acquiredVia item:unpack_set2_predator .
item:19648 priory:acquiredVia item:unpack_set2_predator .

item:29168 priory:acquiredVia item:unpack_set2_quip .
item:19643 priory:acquiredVia item:unpack_set2_quip .

item:29170 priory:acquiredVia item:unpack_set2_meteorlogicus .
item:19645 priory:acquiredVia item:unpack_set2_meteorlogicus .

item:unpack_set2_moot a priory:ContainerUnpackPath, owl:NamedIndividual ;
    rdfs:label "Unpack The Moot Starter Kit from Set 2"@en ;
    priory:fromContainer item:101123 ;
    priory:grantsItem item:29166, item:19642 .

item:unpack_set2_predator a priory:ContainerUnpackPath, owl:NamedIndividual ;
    rdfs:label "Unpack The Predator Starter Kit from Set 2"@en ;
    priory:fromContainer item:101123 ;
    priory:grantsItem item:29173, item:19648 .

item:unpack_set2_quip a priory:ContainerUnpackPath, owl:NamedIndividual ;
    rdfs:label "Unpack Quip Starter Kit from Set 2"@en ;
    priory:fromContainer item:101123 ;
    priory:grantsItem item:29168, item:19643 .

item:unpack_set2_meteorlogicus a priory:ContainerUnpackPath, owl:NamedIndividual ;
    rdfs:label "Unpack Meteorlogicus Starter Kit from Set 2"@en ;
    priory:fromContainer item:101123 ;
    priory:grantsItem item:29170, item:19645 .
