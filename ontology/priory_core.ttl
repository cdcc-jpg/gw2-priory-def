@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix priory-ref: <https://priory.gw2/ref/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix weapon: <https://priory.gw2/ref/weapon/> .
@prefix discipline: <https://priory.gw2/ref/discipline/> .
@prefix gamemode: <https://priory.gw2/ref/gamemode/> .
@prefix currency: <https://priory.gw2/ref/currency/> .
@prefix armor: <https://priory.gw2/ref/armor/> .
@prefix slot: <https://priory.gw2/ref/slot/> .
@prefix itemtype: <https://priory.gw2/ref/itemtype/> .

<https://priory.gw2/def/> a owl:Ontology ;
    rdfs:label "Project Priory Core Ontology"@en ;
    rdfs:comment "Formal OWL 2 DL ontology defining Guild Wars 2 items, recipes, equipment, acquisition pathways, and spatial waypoints."@en ;
    owl:versionInfo "0.2.0" .

# ==============================================================================
# Class Hierarchy (TBox)
# ==============================================================================

# --- Base Entity & Item Taxonomy ---

priory:Entity a owl:Class ;
    rdfs:label "Game Entity"@en ;
    rdfs:comment "Root abstract class for all entities in Guild Wars 2."@en .

priory:Item a owl:Class ;
    rdfs:subClassOf priory:Entity ;
    rdfs:label "Game Item"@en ;
    rdfs:comment "An item or resource that can exist in an account inventory, bank, or legendary armory."@en .

priory:EquipableItem a owl:Class ;
    rdfs:subClassOf priory:Item ;
    rdfs:label "Equipable Item"@en ;
    rdfs:comment "An item that can be equipped onto a character equipment tab."@en .

priory:LegendaryItem a owl:Class ;
    rdfs:subClassOf priory:Item ;
    rdfs:label "Legendary Item"@en ;
    rdfs:comment "An account-wide prestige item bound to the Legendary Armory."@en .

# --- Weapons ---

priory:Weapon a owl:Class ;
    rdfs:subClassOf priory:EquipableItem ;
    rdfs:label "Weapon"@en ;
    rdfs:comment "A combat weapon equipable in main-hand, off-hand, two-hand, or aquatic slots."@en .

priory:LegendaryWeapon a owl:Class ;
    rdfs:subClassOf priory:Weapon, priory:LegendaryItem ;
    rdfs:label "Legendary Weapon"@en ;
    rdfs:comment "Generation 1, 2, or 3 Legendary Weapons."@en .

priory:PrecursorWeapon a owl:Class ;
    rdfs:subClassOf priory:Weapon ;
    rdfs:label "Precursor Weapon"@en ;
    rdfs:comment "The base Exotic or Ascended weapon required to forge a Legendary Weapon."@en .

# --- Armor & Equipment ---

priory:Armor a owl:Class ;
    rdfs:subClassOf priory:EquipableItem ;
    rdfs:label "Armor Piece"@en ;
    rdfs:comment "Wearable armor piece classified by weight (Heavy, Medium, Light) and slot (Helm, Chest, etc.)."@en .

priory:LightArmor a owl:Class ;
    rdfs:subClassOf priory:Armor ;
    rdfs:label "Light Armor"@en ;
    rdfs:comment "Armor wearable by light armor professions (Elementalist, Mesmer, Necromancer) crafted via Tailor."@en .

priory:MediumArmor a owl:Class ;
    rdfs:subClassOf priory:Armor ;
    rdfs:label "Medium Armor"@en ;
    rdfs:comment "Armor wearable by medium armor professions (Engineer, Ranger, Thief) crafted via Leatherworker."@en .

priory:HeavyArmor a owl:Class ;
    rdfs:subClassOf priory:Armor ;
    rdfs:label "Heavy Armor"@en ;
    rdfs:comment "Armor wearable by heavy armor professions (Guardian, Revenant, Warrior) crafted via Armorsmith."@en .

priory:LegendaryArmor a owl:Class ;
    rdfs:subClassOf priory:Armor, priory:LegendaryItem ;
    rdfs:label "Legendary Armor"@en ;
    rdfs:comment "Prestige Legendary Armor sets (Envoy Raid Armor, Obsidian Open World Armor, Mistforged WvW/PvP Armor)."@en .

priory:PrecursorArmor a owl:Class ;
    rdfs:subClassOf priory:Armor ;
    rdfs:label "Precursor Armor"@en ;
    rdfs:comment "Refined Envoy Armor or precursor armor pieces required to forge Legendary Armor."@en .

# --- Trinkets & Back Items ---

priory:Trinket a owl:Class ;
    rdfs:subClassOf priory:EquipableItem ;
    rdfs:label "Trinket / Jewelry"@en ;
    rdfs:comment "Amulets, Rings, and Accessories equipable in jewelry slots."@en .

priory:LegendaryTrinket a owl:Class ;
    rdfs:subClassOf priory:Trinket, priory:LegendaryItem ;
    rdfs:label "Legendary Trinket"@en ;
    rdfs:comment "Legendary jewelry items (Aurora, Vision, Coalescence, Conflux, Transcendence, Prismatic Champion's Regalia)."@en .

priory:BackpackItem a owl:Class ;
    rdfs:subClassOf priory:EquipableItem ;
    rdfs:label "Back Item / Backpack"@en ;
    rdfs:comment "Equipment slotted into the back slot."@en .

priory:LegendaryBackpack a owl:Class ;
    rdfs:subClassOf priory:BackpackItem, priory:LegendaryItem ;
    rdfs:label "Legendary Back Item"@en ;
    rdfs:comment "Legendary back pieces (Ad Infinitum, The Ascension, Warbringer)."@en .

# --- Upgrade Components ---

priory:UpgradeComponent a owl:Class ;
    rdfs:subClassOf priory:Item ;
    rdfs:label "Upgrade Component"@en ;
    rdfs:comment "An upgrade item slotted into weapons, armor, or trinkets."@en .

priory:Sigil a owl:Class ;
    rdfs:subClassOf priory:UpgradeComponent ;
    rdfs:label "Sigil"@en .

priory:LegendarySigil a owl:Class ;
    rdfs:subClassOf priory:Sigil, priory:LegendaryItem ;
    rdfs:label "Legendary Sigil"@en ;
    rdfs:comment "A legendary upgrade component usable across all weapons in the Legendary Armory."@en .

priory:Rune a owl:Class ;
    rdfs:subClassOf priory:UpgradeComponent ;
    rdfs:label "Rune"@en .

priory:LegendaryRune a owl:Class ;
    rdfs:subClassOf priory:Rune, priory:LegendaryItem ;
    rdfs:label "Legendary Rune"@en .

priory:Relic a owl:Class ;
    rdfs:subClassOf priory:UpgradeComponent ;
    rdfs:label "Relic"@en ;
    rdfs:comment "Build-defining combat upgrade slotted into the Relic slot."@en .

priory:LegendaryRelic a owl:Class ;
    rdfs:subClassOf priory:Relic, priory:LegendaryItem ;
    rdfs:label "Legendary Relic"@en .

# --- Materials, Gifts, Currencies ---

priory:CraftingMaterial a owl:Class ;
    rdfs:subClassOf priory:Item ;
    rdfs:label "Crafting Material"@en .

priory:GiftItem a owl:Class ;
    rdfs:subClassOf priory:Item ;
    rdfs:label "Gift Component"@en ;
    rdfs:comment "Intermediate gift components used in high-level Mystic Forge and legendary recipes."@en .

priory:Currency a owl:Class ;
    rdfs:label "Game Currency"@en ;
    rdfs:comment "Account-wide wallet currency, map currency, or barter token."@en .

# --- Recipe & Acquisition Classes ---

priory:Recipe a owl:Class ;
    rdfs:label "Recipe"@en ;
    rdfs:comment "A transformation process taking ingredient inputs to produce an item output."@en .

priory:DisciplineRecipe a owl:Class ;
    rdfs:subClassOf priory:Recipe ;
    rdfs:label "Discipline Crafting Recipe"@en ;
    rdfs:comment "A deterministic recipe executed at a crafting station requiring a specific discipline."@en .

priory:MysticForgeRecipe a owl:Class ;
    rdfs:subClassOf priory:Recipe ;
    rdfs:label "Mystic Forge Recipe"@en ;
    rdfs:comment "A recipe executed in the Mystic Forge using up to 4 ingredients."@en .

priory:IngredientRequirement a owl:Class ;
    rdfs:label "Ingredient Requirement"@en ;
    rdfs:comment "Reified N-ary relation specifying a required item or currency and its exact quantity."@en .

priory:AcquisitionPath a owl:Class ;
    rdfs:label "Acquisition Pathway"@en ;
    skos:definition "A method by which a player can obtain an item or currency in Guild Wars 2."@en ;
    rdfs:comment "A method by which a player can obtain an item or currency."@en .

priory:CraftingPath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Crafting Acquisition"@en ;
    skos:altLabel "craft"@en, "forge"@en, "make"@en, "build"@en ;
    skos:definition "Acquiring an item through crafting disciplines or Mystic Forge recipe transformations."@en .

priory:VendorExchangePath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Vendor Exchange"@en ;
    skos:altLabel "buy"@en, "purchase"@en, "vendor"@en, "merchant"@en, "barter"@en ;
    skos:definition "Acquiring an item from an NPC merchant using wallet currencies or map tokens."@en .

priory:TradingPostPurchasePath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Trading Post Purchase"@en ;
    skos:altLabel "tp"@en, "trading post"@en, "buy on tp"@en, "instant buy"@en ;
    skos:definition "Acquiring a tradeable item via Black Lion Trading Post commerce."@en .

priory:AchievementCollectionPath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Achievement Collection Journey"@en ;
    skos:altLabel "achievement"@en, "quest"@en, "collection"@en, "unlock"@en, "journey"@en ;
    skos:definition "Unlocking an item by completing achievement milestones, masteries, and story tasks."@en .

priory:RewardTrackPath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "WvW/PvP Reward Track"@en ;
    skos:altLabel "reward track"@en, "wvw track"@en, "pvp track"@en, "wvw"@en, "pvp"@en ;
    skos:definition "Earning an item by progressing competitive WvW or PvP reward tracks."@en .

priory:RaidMilestonePath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Raid / Strike Milestone"@en ;
    skos:altLabel "raid"@en, "strike"@en, "boss kill"@en, "insights"@en ;
    skos:definition "Earning prestige items by defeating raid wings or strike mission bosses."@en .

priory:ContainerUnpackPath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Container Unpack Acquisition"@en ;
    skos:altLabel "unpack"@en, "open chest"@en, "starter kit"@en, "choice chest"@en, "open box"@en ;
    skos:definition "Acquiring an item or precursor by unpacking or selecting it from a container chest or starter kit in inventory or bank."@en .

priory:ContainerItem a owl:Class ;
    rdfs:subClassOf priory:Item ;
    rdfs:label "Container / Chest"@en ;
    rdfs:comment "An inventory container, chest, or kit that can be opened or unpacked to yield items."@en .

priory:ChoiceChest a owl:Class ;
    rdfs:subClassOf priory:ContainerItem ;
    rdfs:label "Choice Chest"@en ;
    rdfs:comment "A container that allows the player to select one item package from a predefined list of choices."@en .

priory:LegendaryStarterKit a owl:Class ;
    rdfs:subClassOf priory:ChoiceChest ;
    rdfs:label "Legendary Weapon Starter Kit"@en ;
    rdfs:comment "Wizard's Vault starter kit providing a choice of Gen 1 legendary precursors, gifts, and crafting materials."@en .

priory:TimeGate a owl:Class ;
    rdfs:label "Time Gate & Cooldown Constraint"@en ;
    skos:altLabel "daily reset"@en, "weekly reset"@en, "cooldown"@en, "time gate"@en ;
    skos:definition "Limits the frequency or quantity of crafting/purchasing per unit time."@en ;
    rdfs:comment "Limits the frequency or quantity of crafting/purchasing per unit time."@en .

priory:ItemBuff a owl:Class ;
    rdfs:subClassOf priory:Entity ;
    rdfs:label "Item Buff / Booster"@en ;
    rdfs:comment "A consumable booster, guild tavern buff, or enhancement that accelerates gameplay or reward track progression."@en .

# --- Convenience Gizmos & VIP Lounges ---

priory:ConvenienceGizmo a owl:Class ;
    rdfs:subClassOf priory:Item ;
    rdfs:label "Convenience Gizmo"@en ;
    skos:altLabel "Gizmo"@en, "Utility Gizmo"@en ;
    rdfs:comment "An account utility gizmo, infinite salvage tool, or VIP teleportation pass."@en .

priory:VIPLoungePass a owl:Class ;
    rdfs:subClassOf priory:ConvenienceGizmo ;
    rdfs:label "VIP Lounge Pass"@en ;
    skos:altLabel "Passkey"@en, "Lounge Scroll"@en, "Bastion Pass"@en ;
    rdfs:comment "A permanent or reusable pass providing unlimited access to exclusive lounges and bastion hubs with complete amenities."@en .

priory:InfiniteSalvageItem a owl:Class ;
    rdfs:subClassOf priory:ConvenienceGizmo ;
    rdfs:label "Infinite Salvage-o-Matic"@en ;
    skos:altLabel "Salvage-o-Matic"@en, "Infinite Salvage Kit"@en ;
    rdfs:comment "An infinite-use salvage kit powered by account copper/silver or karma."@en .

priory:PermanentContract a owl:Class ;
    rdfs:subClassOf priory:ConvenienceGizmo ;
    rdfs:label "Permanent Contract"@en ;
    skos:altLabel "Permanent Service Contract"@en, "Express Contract"@en ;
    rdfs:comment "A permanent, unlimited-use contract granting instant portable access to banking, trading post, merchant, or styling services from anywhere."@en .

priory:CurrencyConverter a owl:Class ;
    rdfs:subClassOf priory:ConvenienceGizmo ;
    rdfs:label "Currency Converter / Gobbler"@en ;
    skos:altLabel "Converter"@en, "Gobbler"@en, "Material Converter"@en ;
    rdfs:comment "A portable exchanger or gobbler consuming crafting materials, karma, or map currencies in exchange for reward containers and boosts."@en .

priory:PortalTome a owl:Class ;
    rdfs:subClassOf priory:ConvenienceGizmo ;
    rdfs:label "Portal Tome / Teleporter"@en ;
    skos:altLabel "Teleportation Scroll"@en, "Portal Tome"@en, "Portal Scroll"@en ;
    rdfs:comment "A reusable tome, scroll, or stone that transports players to specific Living World or expansion zones."@en .

priory:AccountStorageUpgrade a owl:Class ;
    rdfs:subClassOf priory:ConvenienceGizmo ;
    rdfs:label "Account Storage Upgrade"@en ;
    skos:altLabel "Storage Upgrade"@en, "Account Expansion"@en ;
    rdfs:comment "An account-wide upgrade expanding shared inventory slots, bank tab capacity, or material storage limit."@en .

priory:SafeStagingBag a owl:Class ;
    rdfs:subClassOf priory:ConvenienceGizmo ;
    rdfs:label "Safe Staging Bag / Invisible Bag / Safe Box"@en ;
    skos:altLabel "Invisible Bag"@en, "Safe Box"@en, "Invisible Pack"@en, "Safe Staging Bag"@en ;
    rdfs:comment "An inventory bag or safe box whose contents are immune to vendor selling, deposit all materials, and auto-compaction, used for staging valuable legendary precursors and unbound items."@en .

priory:LoungeFeature a owl:Class ;
    rdfs:label "Lounge Amenity / Feature"@en ;
    rdfs:comment "An amenity, service, or portal feature available within a VIP Lounge or hub."@en .

# ==============================================================================
# Object Properties (Verbs / Verb Phrases)
# ==============================================================================

priory:unpacksInto a owl:ObjectProperty ;
    rdfs:domain priory:ContainerItem ;
    rdfs:range priory:Item ;
    rdfs:label "unpacks into"@en ;
    skos:definition "Connects a container or starter kit to the items it produces when opened or selected."@en .

priory:unpacksFrom a owl:ObjectProperty ;
    owl:inverseOf priory:unpacksInto ;
    rdfs:domain priory:Item ;
    rdfs:range priory:ContainerItem ;
    rdfs:label "unpacks from"@en .

priory:fromContainer a owl:ObjectProperty ;
    rdfs:domain priory:ContainerUnpackPath ;
    rdfs:range priory:ContainerItem ;
    rdfs:label "from container"@en .

priory:grantsItem a owl:ObjectProperty ;
    rdfs:domain priory:ContainerUnpackPath ;
    rdfs:range priory:Item ;
    rdfs:label "grants item"@en .

priory:producesItem a owl:ObjectProperty ;
    rdfs:domain priory:Recipe ;
    rdfs:range priory:Item ;
    rdfs:label "produces item"@en .

priory:producedBy a owl:ObjectProperty ;
    owl:inverseOf priory:producesItem ;
    rdfs:domain priory:Item ;
    rdfs:range priory:Recipe ;
    rdfs:label "produced by"@en ;
    skos:altLabel "craft"@en, "forge"@en, "make"@en, "build"@en ;
    skos:definition "Links an item to the crafting or Mystic Forge recipe that produces it."@en .

priory:hasIngredientRequirement a owl:ObjectProperty ;
    rdfs:domain priory:Recipe ;
    rdfs:range priory:IngredientRequirement ;
    rdfs:label "has ingredient requirement"@en .

priory:requiresItem a owl:ObjectProperty ;
    rdfs:domain priory:IngredientRequirement ;
    rdfs:range priory:Item ;
    rdfs:label "requires item"@en .

priory:requiresCurrency a owl:ObjectProperty ;
    rdfs:range skos:Concept ;
    rdfs:label "requires currency"@en .

priory:requiresIngredient a owl:ObjectProperty ;
    rdfs:domain priory:Recipe ;
    rdfs:range priory:Item ;
    rdfs:label "requires ingredient (RDF-star compatible)"@en .

priory:acquiredVia a owl:ObjectProperty ;
    rdfs:domain priory:Item ;
    rdfs:range priory:AcquisitionPath ;
    rdfs:label "acquired via"@en .

priory:hasSubstituteSource a owl:ObjectProperty ;
    rdfs:domain priory:Item ;
    rdfs:range priory:AcquisitionPath ;
    rdfs:label "has alternative acquisition source"@en .

priory:requiresDiscipline a owl:ObjectProperty ;
    rdfs:domain priory:DisciplineRecipe ;
    rdfs:range skos:Concept ;
    rdfs:label "requires discipline"@en .

priory:hasRarity a owl:ObjectProperty ;
    rdfs:domain priory:Item ;
    rdfs:range skos:Concept ;
    rdfs:label "has rarity"@en .

priory:hasWeaponType a owl:ObjectProperty ;
    rdfs:domain priory:Weapon ;
    rdfs:range skos:Concept ;
    rdfs:label "has weapon type"@en .

priory:hasArmorWeight a owl:ObjectProperty ;
    rdfs:domain priory:Armor ;
    rdfs:range skos:Concept ;
    rdfs:label "has armor weight"@en .

priory:hasEquipmentSlot a owl:ObjectProperty ;
    rdfs:domain priory:EquipableItem ;
    rdfs:range skos:Concept ;
    rdfs:label "has equipment slot"@en .

priory:hasItemType a owl:ObjectProperty ;
    rdfs:domain priory:Item ;
    rdfs:range skos:Concept ;
    rdfs:label "has item type"@en .

priory:hasUpgradeType a owl:ObjectProperty ;
    rdfs:domain priory:UpgradeComponent ;
    rdfs:range skos:Concept ;
    rdfs:label "has upgrade type"@en .

priory:hasGameMode a owl:ObjectProperty ;
    rdfs:domain priory:AcquisitionPath ;
    rdfs:range skos:Concept ;
    rdfs:label "associated game mode"@en .

priory:hasTimeGate a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (priory:Recipe priory:AcquisitionPath priory:Item) ] ;
    rdfs:range priory:TimeGate ;
    rdfs:label "has time gate"@en .

priory:acceleratedBy a owl:ObjectProperty ;
    rdfs:domain priory:AcquisitionPath ;
    rdfs:range priory:ItemBuff ;
    rdfs:label "accelerated by"@en ;
    rdfs:comment "Specifies consumable boosters, guild tavern enhancements, or account buffs that accelerate progression on this acquisition path."@en .

priory:hasFeature a owl:ObjectProperty ;
    rdfs:domain priory:Item ;
    rdfs:label "has feature / amenity"@en ;
    rdfs:comment "Specifies an amenity, portal, or convenience feature provided by this item or lounge."@en .

priory:hasLoungeFeature a owl:ObjectProperty ;
    rdfs:subPropertyOf priory:hasFeature ;
    rdfs:label "has lounge amenity"@en ;
    rdfs:comment "Specifies a VIP lounge service or amenity available at this lounge hub."@en .

# ==============================================================================
# Datatype Properties (Noun Phrases / Booleans)
# ==============================================================================

priory:gw2Id a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (priory:Item priory:Recipe priory:Currency) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "GW2 Official API Item ID"@en .

priory:gw2RecipeId a owl:DatatypeProperty ;
    rdfs:domain priory:Recipe ;
    rdfs:range xsd:integer ;
    rdfs:label "GW2 Official API Recipe ID"@en .

priory:chatCode a owl:DatatypeProperty ;
    rdfs:domain priory:Item ;
    rdfs:range xsd:string ;
    rdfs:label "In-game Chat Link Code"@en .

priory:chatLink a owl:DatatypeProperty ;
    rdfs:subPropertyOf priory:chatCode ;
    owl:equivalentProperty priory:chatCode ;
    rdfs:domain priory:Item ;
    rdfs:range xsd:string ;
    rdfs:label "In-game Chat Link Code (alias)"@en .

priory:requiredQuantity a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "required quantity"@en .

priory:outputQuantity a owl:DatatypeProperty ;
    rdfs:domain priory:Recipe ;
    rdfs:range xsd:integer ;
    rdfs:label "output quantity"@en .

priory:requiredRating a owl:DatatypeProperty ;
    rdfs:domain priory:DisciplineRecipe ;
    rdfs:range xsd:integer ;
    rdfs:label "required discipline rating (0-500)"@en .

priory:requiresRating a owl:DatatypeProperty ;
    rdfs:subPropertyOf priory:requiredRating ;
    rdfs:label "required discipline rating (legacy alias)"@en .

priory:maxRating a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "maximum achievable discipline rating (400 or 500)"@en ;
    rdfs:comment "Specifies the highest crafting level achievable for a crafting discipline in Guild Wars 2."@en .

priory:isAccountBound a owl:DatatypeProperty ;
    rdfs:domain priory:Item ;
    rdfs:range xsd:boolean ;
    rdfs:label "is account bound"@en .

priory:expectedYieldRate a owl:DatatypeProperty ;
    rdfs:domain priory:MysticForgeRecipe ;
    rdfs:range xsd:decimal ;
    rdfs:label "expected yield probability rate"@en .

priory:duration a owl:DatatypeProperty ;
    rdfs:domain priory:ItemBuff ;
    rdfs:range xsd:string ;
    rdfs:label "buff duration"@en .

priory:accelerationMultiplier a owl:DatatypeProperty ;
    rdfs:domain priory:ItemBuff ;
    rdfs:range xsd:string ;
    rdfs:label "acceleration multiplier rate"@en .

# --- Convenience Gizmo & VIP Lounge Properties ---

priory:salvageCostPerUse a owl:DatatypeProperty ;
    rdfs:domain priory:InfiniteSalvageItem ;
    rdfs:range xsd:integer ;
    rdfs:label "salvage cost per use (copper)"@en ;
    rdfs:comment "Cost in copper coins per salvage action."@en .

priory:salvageRarityRate a owl:DatatypeProperty ;
    rdfs:domain priory:InfiniteSalvageItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "salvage rare material rate"@en ;
    rdfs:comment "Percentage probability of obtaining rarer materials (0.0 to 1.0)."@en .

priory:salvageUpgradeRate a owl:DatatypeProperty ;
    rdfs:domain priory:InfiniteSalvageItem ;
    rdfs:range xsd:decimal ;
    rdfs:label "salvage upgrade recovery rate"@en ;
    rdfs:comment "Percentage probability of recovering upgrades or charm/symbol conversion rate (0.0 to 1.0)."@en .

priory:hasCraftingStations a owl:DatatypeProperty ;
    rdfs:domain priory:VIPLoungePass ;
    rdfs:range xsd:boolean ;
    rdfs:label "has all crafting stations"@en .

priory:hasMysticForge a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (priory:VIPLoungePass priory:ConvenienceGizmo) ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "has Mystic Forge access"@en .

priory:hasBank a owl:DatatypeProperty ;
    rdfs:domain priory:VIPLoungePass ;
    rdfs:range xsd:boolean ;
    rdfs:label "has bank and guild bank access"@en .

priory:hasTradingPost a owl:DatatypeProperty ;
    rdfs:domain priory:VIPLoungePass ;
    rdfs:range xsd:boolean ;
    rdfs:label "has Black Lion Trading Post access"@en .

priory:hasVendor a owl:DatatypeProperty ;
    rdfs:domain priory:VIPLoungePass ;
    rdfs:range xsd:boolean ;
    rdfs:label "has merchants and armor repair vendors"@en .

priory:hasInstantReturn a owl:DatatypeProperty ;
    rdfs:domain priory:VIPLoungePass ;
    rdfs:range xsd:boolean ;
    rdfs:label "has instant return to previous open world map"@en .

priory:bagSlots a owl:DatatypeProperty ;
    rdfs:domain priory:SafeStagingBag ;
    rdfs:range xsd:integer ;
    rdfs:label "bag slot capacity"@en .

# --- Spatial & Waypoint Navigation Properties ---

priory:vendorNPC a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (priory:VendorExchangePath priory:AcquisitionPath) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Vendor / Relevant NPC Name"@en .

priory:zoneName a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (priory:VendorExchangePath priory:AcquisitionPath) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Map / Zone Name"@en .

priory:waypointName a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (priory:VendorExchangePath priory:AcquisitionPath) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Waypoint Name"@en .

priory:nearestWaypoint a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf (priory:VendorExchangePath priory:AcquisitionPath) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Nearest In-Game Waypoint Chat Code"@en .

# ==============================================================================
# Controlled Vocabularies: Weapon Taxonomy (SKOS)
# ==============================================================================

priory:WeaponScheme a skos:ConceptScheme ;
    rdfs:label "Guild Wars 2 Weapon Types Taxonomy"@en ;
    skos:prefLabel "Weapon Scheme"@en .

weapon:TwoHandedWeapon a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:prefLabel "Two-Handed Weapon"@en .
weapon:OneHandedWeapon a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:prefLabel "One-Handed Weapon"@en .
weapon:OffHandWeapon a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:prefLabel "Off-Hand Weapon"@en .
weapon:AquaticWeapon a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:prefLabel "Aquatic Weapon"@en .

weapon:Greatsword a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:TwoHandedWeapon ; skos:prefLabel "Greatsword"@en .
weapon:Hammer a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:TwoHandedWeapon ; skos:prefLabel "Hammer"@en .
weapon:Longbow a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:TwoHandedWeapon ; skos:prefLabel "Longbow"@en .
weapon:Rifle a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:TwoHandedWeapon ; skos:prefLabel "Rifle"@en .
weapon:ShortBow a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:TwoHandedWeapon ; skos:prefLabel "Short Bow"@en .
weapon:Staff a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:TwoHandedWeapon ; skos:prefLabel "Staff"@en .

weapon:Axe a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OneHandedWeapon ; skos:prefLabel "Axe"@en .
weapon:Dagger a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OneHandedWeapon ; skos:prefLabel "Dagger"@en .
weapon:Mace a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OneHandedWeapon ; skos:prefLabel "Mace"@en .
weapon:Pistol a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OneHandedWeapon ; skos:prefLabel "Pistol"@en .
weapon:Scepter a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OneHandedWeapon ; skos:prefLabel "Scepter"@en .
weapon:Sword a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OneHandedWeapon ; skos:prefLabel "Sword"@en .

weapon:Focus a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OffHandWeapon ; skos:prefLabel "Focus"@en .
weapon:Shield a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OffHandWeapon ; skos:prefLabel "Shield"@en .
weapon:Torch a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OffHandWeapon ; skos:prefLabel "Torch"@en .
weapon:Warhorn a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:OffHandWeapon ; skos:prefLabel "Warhorn"@en .

weapon:Spear a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:TwoHandedWeapon, weapon:AquaticWeapon ; skos:prefLabel "Spear"@en .
weapon:HarpoonGun a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:AquaticWeapon ; skos:prefLabel "Harpoon Gun"@en .
weapon:Trident a skos:Concept ; skos:inScheme priory:WeaponScheme ; skos:broader weapon:AquaticWeapon ; skos:prefLabel "Trident"@en .

# --- Exploration & Spatial Navigation ---
priory:ExplorationZone a owl:Class ;
    rdfs:subClassOf priory:Entity ;
    rdfs:label "Exploration Zone"@en ;
    rdfs:comment "A geographic zone in Core Tyria contributing to Gift of Exploration map completion."@en .

priory:FarmingLocation a owl:Class ;
    rdfs:subClassOf priory:Entity ;
    rdfs:label "Farming Location"@en ;
    rdfs:comment "An in-game location optimized for farming specific materials or currencies."@en .

priory:DungeonPath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Dungeon Path Acquisition"@en ;
    skos:altLabel "dungeon"@en, "dungeon run"@en, "dungeon path"@en ;
    skos:definition "Acquiring items or tokens by completing specific dungeon explorable paths."@en .

priory:OpenWorldFarmPath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Open World Farming"@en ;
    skos:altLabel "farm"@en, "grind"@en, "meta event"@en, "RIBA"@en ;
    skos:definition "Acquiring materials through open world meta events, champion trains, or material node farming."@en .

priory:MysticForgePromotionPath a owl:Class ;
    rdfs:subClassOf priory:AcquisitionPath ;
    rdfs:label "Mystic Forge Material Promotion"@en ;
    skos:altLabel "promote"@en, "forge promote"@en, "transmute"@en ;
    skos:definition "Using the Mystic Forge to upgrade lower-tier materials into higher-tier materials."@en .

priory:requiresExpansion a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "requires expansion"@en ;
    rdfs:comment "The expansion or living world season required to access this content."@en .

priory:recommendedMount a owl:ObjectProperty ;
    rdfs:range skos:Concept ;
    rdfs:label "recommended mount"@en ;
    rdfs:comment "The mount type that provides the greatest mobility advantage for this activity or zone."@en .

priory:zoneLevel a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "zone minimum level"@en .

priory:explorationDifficulty a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "exploration difficulty rating"@en .

priory:farmingEfficiency a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "farming efficiency rating"@en ;
    rdfs:comment "Approximate gold-per-hour or items-per-hour efficiency for this farming location."@en .

priory:eventCadence a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "event cadence"@en ;
    rdfs:comment "How frequently this event spawns or can be triggered (e.g. every 2 hours, on demand)."@en .

priory:hasRegion a owl:ObjectProperty ;
    rdfs:domain priory:ExplorationZone ;
    rdfs:range skos:Concept ;
    rdfs:label "belongs to region"@en .

# ==============================================================================
# Controlled Vocabularies: Rarity Tiers (SKOS)
# ==============================================================================

priory:RarityScheme a skos:ConceptScheme ;
    rdfs:label "Guild Wars 2 Item Rarity Taxonomy"@en ;
    skos:prefLabel "Rarity Scheme"@en .

rarity:Junk a skos:Concept ; skos:inScheme priory:RarityScheme ; skos:prefLabel "Junk"@en .
rarity:Basic a skos:Concept ; skos:inScheme priory:RarityScheme ; skos:prefLabel "Basic"@en .
rarity:Fine a skos:Concept ; skos:inScheme priory:RarityScheme ; skos:prefLabel "Fine"@en .
rarity:Masterwork a skos:Concept ; skos:inScheme priory:RarityScheme ; skos:prefLabel "Masterwork"@en .
rarity:Rare a skos:Concept ; skos:inScheme priory:RarityScheme ; skos:prefLabel "Rare"@en .
rarity:Exotic a skos:Concept ; skos:inScheme priory:RarityScheme ; skos:prefLabel "Exotic"@en .
rarity:Ascended a skos:Concept ; skos:inScheme priory:RarityScheme ; skos:prefLabel "Ascended"@en .
rarity:Legendary a skos:Concept ; skos:inScheme priory:RarityScheme ; skos:prefLabel "Legendary"@en .

# ==============================================================================
# Controlled Vocabularies: VIP Lounge Amenities (SKOS)
# ==============================================================================

priory:LoungeFeatureScheme a skos:ConceptScheme ;
    rdfs:label "VIP Lounge Amenities and Features Taxonomy"@en ;
    skos:prefLabel "Lounge Feature Scheme"@en .

priory:FeatureCraftingStations a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "All Crafting Stations"@en ;
    rdfs:comment "Access to all eight core crafting discipline stations."@en .

priory:FeatureMysticForge a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Mystic Forge"@en ;
    rdfs:comment "On-site Mystic Forge access."@en .

priory:FeatureBank a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Bank and Guild Bank Access"@en ;
    rdfs:comment "Access to Account Vault and Guild Bank storage."@en .

priory:FeatureTradingPost a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Trading Post Agent"@en ;
    rdfs:comment "Access to Black Lion Trading Post pickup and delivery merchants."@en .

priory:FeatureVendor a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Merchants and Utility Vendors"@en ;
    rdfs:comment "General merchants, laurels, crafting materials, and armor repair."@en .

priory:FeatureInstantReturn a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Instant Return to Open World"@en ;
    rdfs:comment "Special action skill or portal to instantly return to your exact previous location in the open world."@en .

priory:FeatureFractalLobby a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Fractal Hub Portal & Vendors"@en ;
    rdfs:comment "Direct portals and merchants for Fractals of the Mists (Mistlock Sanctuary)."@en .

priory:FeatureWvWVendors a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "WvW Merchants & Siege Testing Arena"@en ;
    rdfs:comment "World vs World siege merchants, tactics, and duel arena (Armistice Bastion)."@en .

priory:FeatureFishing a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Fishing Waters & Jade Bot Workbench"@en ;
    rdfs:comment "Exclusive fishing holes, bait vendors, and Jade Bot Workbench (Thousand Seas Pavilion)."@en .

priory:FeatureStrikePortals a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Strike Mission & Raid Portals"@en ;
    rdfs:comment "Direct launch portals to End of Dragons and expansion Strike Missions."@en .

priory:FeatureStylist a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Hairstylist & Aesthetic Services"@en ;
    rdfs:comment "Personal hairstylist and cosmetic appearance modification services."@en .

priory:FeatureToolDelivery a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Tool Delivery Services"@en ;
    rdfs:comment "Delivery services for infinite gathering tools and harvesting supplies."@en .

priory:FeatureRepair a skos:Concept, priory:LoungeFeature ;
    skos:inScheme priory:LoungeFeatureScheme ;
    skos:prefLabel "Armor Repair Canister Service"@en ;
    rdfs:comment "Instant portable armor repair and reinforcement services."@en .