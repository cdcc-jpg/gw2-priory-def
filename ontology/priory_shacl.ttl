@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix priory-ref: <https://priory.gw2/ref/> .

# ==============================================================================
# SHACL Shapes for Priory Core (7 Acquisition Archetypes)
# ==============================================================================

priory:ItemShape a sh:NodeShape ;
    sh:targetClass priory:Item, priory:LegendaryWeapon, priory:PrecursorWeapon,
                   priory:CraftingMaterial, priory:GiftItem, priory:LegendarySigil, priory:LegendaryRune,
                   priory:Armor, priory:LightArmor, priory:MediumArmor, priory:HeavyArmor, priory:LegendaryArmor, priory:Trinket, priory:LegendaryTrinket ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "Every Item must have at least one rdfs:label." ;
    ] ;
    sh:property [
        sh:path priory:gw2Id ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "Item gw2Id must be a positive integer." ;
    ] ;
    sh:property [
        sh:path priory:hasRarity ;
        sh:nodeKind sh:IRI ;
        sh:message "Item rarity must be an IRI pointing to a SKOS Rarity Concept." ;
    ] .

priory:RecipeShape a sh:NodeShape ;
    sh:targetClass priory:Recipe, priory:DisciplineRecipe, priory:MysticForgeRecipe ;
    sh:property [
        sh:path priory:producesItem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Every recipe must specify exactly one output item." ;
    ] ;
    sh:property [
        sh:path priory:outputQuantity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "Output quantity must be an integer >= 1." ;
    ] .

priory:IngredientRequirementShape a sh:NodeShape ;
    sh:targetClass priory:IngredientRequirement ;
    sh:property [
        sh:path priory:requiredQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "Ingredient requirement must have a positive requiredQuantity." ;
    ] ;
    sh:property [
        sh:path priory:requiresItem ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "requiresItem must point to an Item IRI." ;
    ] .

priory:DisciplineRecipeShape a sh:NodeShape ;
    sh:targetClass priory:DisciplineRecipe ;
    sh:property [
        sh:path priory:requiresDiscipline ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "DisciplineRecipe must specify a crafting discipline." ;
    ] ;
    sh:property [
        sh:path [ sh:alternativePath ( priory:requiredRating priory:requiresRating ) ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 500 ;
        sh:message "requiredRating must be an integer between 0 and 500." ;
    ] .

priory:VendorExchangePathShape a sh:NodeShape ;
    sh:targetClass priory:VendorExchangePath ;
    sh:property [
        sh:path priory:requiresCurrency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "VendorExchangePath must specify a required currency." ;
    ] ;
    sh:property [
        sh:path priory:requiredQuantity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "Vendor exchange requiredQuantity must be a positive integer." ;
    ] .
