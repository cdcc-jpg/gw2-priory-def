@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix priory-ref: <https://priory.gw2/ref/> .
@prefix discipline: <https://priory.gw2/ref/discipline/> .

priory-ref:DisciplineScheme a skos:ConceptScheme ;
    skos:prefLabel "Guild Wars 2 Crafting Discipline Scheme"@en ;
    rdfs:comment "Controlled vocabulary of crafting disciplines in Guild Wars 2 with max rating levels."@en ;
    skos:hasTopConcept discipline:Armorsmith, discipline:Artificer, discipline:Chef,
                       discipline:Huntsman, discipline:Jeweler, discipline:Leatherworker,
                       discipline:Scribe, discipline:Tailor, discipline:Weaponsmith .

discipline:Armorsmith a skos:Concept ;
    skos:inScheme priory-ref:DisciplineScheme ;
    skos:topConceptOf priory-ref:DisciplineScheme ;
    skos:prefLabel "Armorsmith"@en ;
    skos:notation "500"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Armorsmith> .

discipline:Artificer a skos:Concept ;
    skos:inScheme priory-ref:DisciplineScheme ;
    skos:topConceptOf priory-ref:DisciplineScheme ;
    skos:prefLabel "Artificer"@en ;
    skos:notation "500"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Artificer> .

discipline:Chef a skos:Concept ;
    skos:inScheme priory-ref:DisciplineScheme ;
