@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory-ref: <https://priory.gw2/ref/> .
@prefix gamemode: <https://priory.gw2/ref/gamemode/> .

priory-ref:GameModeScheme a skos:ConceptScheme ;
    skos:prefLabel "Guild Wars 2 Game Mode & Activity Taxonomy"@en ;
    rdfs:comment "SKOS taxonomy of game modes and activity types in Guild Wars 2."@en ;
    skos:hasTopConcept gamemode:PvE, gamemode:WvW, gamemode:PvP .

# --- PvE ---
gamemode:PvE a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:topConceptOf priory-ref:GameModeScheme ;
    skos:prefLabel "Player vs Environment (PvE)"@en ;
    skos:narrower gamemode:OpenWorld, gamemode:InstancedPvE .

gamemode:OpenWorld a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:PvE ;
    skos:prefLabel "Open World PvE"@en ;
    skos:narrower gamemode:MapCompletion, gamemode:MetaEvents, gamemode:WorldBosses, gamemode:RiftHunting .

gamemode:MapCompletion a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:OpenWorld ;
    skos:prefLabel "Map Completion"@en ;
    rdfs:comment "Completing hearts, waypoints, POIs, vistas, and hero points."@en .

gamemode:MetaEvents a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:OpenWorld ;
    skos:prefLabel "Zone Meta Events"@en .

gamemode:WorldBosses a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:OpenWorld ;
    skos:prefLabel "World Bosses"@en .

gamemode:RiftHunting a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:OpenWorld ;
    skos:prefLabel "Rift Hunting & Convergences"@en .

gamemode:InstancedPvE a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:PvE ;
    skos:prefLabel "Instanced PvE"@en ;
    skos:narrower gamemode:Dungeons, gamemode:Fractals, gamemode:StrikeMissions, gamemode:Raids .

gamemode:Dungeons a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:InstancedPvE ;
    skos:prefLabel "Dungeons"@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Dungeon> .

gamemode:Fractals a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:InstancedPvE ;
    skos:prefLabel "Fractals of the Mists"@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Fractals_of_the_Mists> .

gamemode:StrikeMissions a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:InstancedPvE ;
    skos:prefLabel "Strike Missions"@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Strike_Mission> .

gamemode:Raids a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:InstancedPvE ;
    skos:prefLabel "Raids"@en ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Raid> .

# --- WvW ---
gamemode:WvW a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:topConceptOf priory-ref:GameModeScheme ;
    skos:prefLabel "World vs World (WvW)"@en ;
    skos:narrower gamemode:WvWRewardTrack, gamemode:WvWRoaming, gamemode:WvWZerg .

gamemode:WvWRewardTrack a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:WvW ;
    skos:prefLabel "WvW Reward Tracks"@en ;
    rdfs:comment "Progression tracks delivering Gift of Battle and specific dungeon/map gifts."@en .

gamemode:WvWRoaming a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:WvW ;
    skos:prefLabel "WvW Roaming / Havoc"@en .

gamemode:WvWZerg a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:WvW ;
    skos:prefLabel "WvW Squad / Zerg Combat"@en .

# --- PvP ---
gamemode:PvP a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:topConceptOf priory-ref:GameModeScheme ;
    skos:prefLabel "Structured PvP (sPvP)"@en ;
    skos:narrower gamemode:PvPRewardTrack, gamemode:PvPRanked, gamemode:PvPUnranked .

gamemode:PvPRewardTrack a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:PvP ;
    skos:prefLabel "sPvP Reward Tracks"@en .

gamemode:PvPRanked a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:PvP ;
    skos:prefLabel "Ranked PvP Arena"@en .

gamemode:PvPUnranked a skos:Concept ;
    skos:inScheme priory-ref:GameModeScheme ;
    skos:broader gamemode:PvP ;
    skos:prefLabel "Unranked PvP Arena"@en .
