@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix priory: <https://priory.gw2/def/> .
@prefix region: <https://priory.gw2/ref/region/> .

priory:RegionScheme a skos:ConceptScheme ;
    rdfs:label "Core Tyria Geographic Regions Taxonomy"@en ;
    skos:prefLabel "Core Tyria Region Scheme"@en ;
    skos:definition "A SKOS concept scheme that classifies the major geographic regions of Central Tyria required for World Completion."@en .

region:Ascalon a skos:Concept ;
    skos:inScheme priory:RegionScheme ;
    skos:prefLabel "Ascalon"@en ;
    skos:definition "A Core Tyria geographic region concept representing the eastern Charr homeland scarred by the Foefire and the Dragonbrand."@en .

region:Kryta a skos:Concept ;
    skos:inScheme priory:RegionScheme ;
    skos:prefLabel "Kryta"@en ;
    skos:definition "A Core Tyria geographic region concept representing the temperate coastal human kingdom surrounding Divinity's Reach and Lion's Arch."@en .

region:MaguumaJungle a skos:Concept ;
    skos:inScheme priory:RegionScheme ;
    skos:prefLabel "Tarnished Coast / Maguuma Jungle"@en ;
    skos:definition "A Core Tyria geographic region concept representing the lush western jungle inhabited by the Asura of Rata Sum and Sylvari of The Grove."@en .

region:ShiverpeakMountains a skos:Concept ;
    skos:inScheme priory:RegionScheme ;
    skos:prefLabel "Shiverpeak Mountains"@en ;
    skos:definition "A Core Tyria geographic region concept representing the glaciated central mountain range inhabited by the Norn and Dredge."@en .

region:RuinsOfOrr a skos:Concept ;
    skos:inScheme priory:RegionScheme ;
    skos:prefLabel "Ruins of Orr"@en ;
    skos:definition "A Core Tyria geographic region concept representing the risen-corrupted southern peninsula raised from the Sea of Sorrows by Zhaitan."@en .
