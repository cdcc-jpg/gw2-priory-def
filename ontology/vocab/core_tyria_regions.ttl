region:CoreTyriaRegionScheme a skos:ConceptScheme ;
    skos:prefLabel "Core Tyria Regions"@en .

region:Kryta a skos:Concept ;
    skos:inScheme region:CoreTyriaRegionScheme ;
    skos:prefLabel "Kryta"@en .

region:Ascalon a skos:Concept ;
    skos:inScheme region:CoreTyriaRegionScheme ;
    skos:prefLabel "Ascalon"@en .

region:Shiverpeaks a skos:Concept ;
    skos:inScheme region:CoreTyriaRegionScheme ;
    skos:prefLabel "Shiverpeak Mountains"@en .

region:MaguumaJungle a skos:Concept ;
    skos:inScheme region:CoreTyriaRegionScheme ;
    skos:prefLabel "Maguuma Jungle"@en .

region:RuinsOfOrr a skos:Concept ;
    skos:inScheme region:CoreTyriaRegionScheme ;
    skos:prefLabel "Ruins of Orr"@en .

zone:Queensdale a skos:Concept ;
    skos:broader region:Kryta ;
    skos:prefLabel "Queensdale"@en ;
    priory:zoneLevel 1 ;
    priory:explorationDifficulty "Easy" ;
    priory:mountRecommendation "Raptor canyon leap useful" .

