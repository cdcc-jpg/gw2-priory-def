    rdfs:label "Laurel"@en ;
    skos:prefLabel "Laurel"@en ;
    skos:altLabel "Laurel"@en ;
    skos:definition "An account wallet scalar currency that is obtained from the Wizard's Vault and exchanged at Laurel Merchants for crafting bags, Ascended trinkets, and recipes."@en ;
    priory:apiWalletId 3 ;
    priory:isContainerized false ;
    priory:playsRole role:CurrencyExchange,
        role:CraftingIngredient ;
    owl:sameAs currency:3 .

currency:3 a owl:NamedIndividual ;
    owl:sameAs currency:Laurel .

