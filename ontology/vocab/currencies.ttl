@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix iao: <http://purl.obolibrary.org/obo/> .
@prefix priory: <https://priory.gw2/def/> .
@prefix role: <https://priory.gw2/ref/role/> .
@prefix currency: <https://priory.gw2/ref/currency/> .

priory:CurrencyScheme a skos:ConceptScheme ;
    rdfs:label "Guild Wars 2 Account Wallet Currencies Taxonomy"@en ;
    skos:prefLabel "Currency Scheme"@en ;
    skos:definition "A SKOS concept scheme that classifies account-wide wallet scalar currencies tracked by the Guild Wars 2 `/v2/currencies` API."@en .

currency:Coin a owl:NamedIndividual,
        skos:Concept,
        priory:Currency,
        priory:AccountWalletScalar ;
    skos:inScheme priory:CurrencyScheme ;
    rdfs:label "Coin"@en ;
    skos:prefLabel "Coin"@en ;
    skos:altLabel "Gold"@en, "Silver"@en, "Copper"@en ;
    skos:definition "An account wallet scalar currency that serves as the primary liquid monetary medium of exchange (denominated in copper, silver, and gold) for Trading Post commerce, vendor purchases, and waypoint travel."@en ;
    priory:apiWalletId 1 ;
    priory:isContainerized false ;
    priory:playsRole role:CurrencyExchange,
        role:CraftingIngredient ;
    owl:sameAs currency:1 .

currency:1 a owl:NamedIndividual ;
    owl:sameAs currency:Coin .

currency:Karma a owl:NamedIndividual,
        skos:Concept,
        priory:Currency,
        priory:AccountWalletScalar ;
    skos:inScheme priory:CurrencyScheme ;
    rdfs:label "Karma"@en ;
    skos:prefLabel "Karma"@en ;
    skos:altLabel "Karma"@en ;
    skos:definition "An account wallet scalar currency that is awarded for completing dynamic events and renown hearts and exchanged with karma merchants for Obsidian Shards, recipes, and equipment."@en ;
    priory:apiWalletId 2 ;
    priory:isContainerized false ;
    priory:playsRole role:CurrencyExchange,
        role:CraftingIngredient ;
    owl:sameAs currency:2 .

currency:2 a owl:NamedIndividual ;
    owl:sameAs currency:Karma .

currency:Laurel a owl:NamedIndividual,
        skos:Concept,
        priory:Currency,
        priory:AccountWalletScalar ;
