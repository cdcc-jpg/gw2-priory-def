@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix iao: <http://purl.obolibrary.org/obo/> .
@prefix priory: <https://priory.gw2/def/> .
@prefix role: <https://priory.gw2/ref/role/> .

role:GameRoleScheme a skos:ConceptScheme ;
    rdfs:label "Guild Wars 2 Contextual Game Roles Taxonomy"@en ;
    skos:prefLabel "Game Role Scheme"@en ;
    skos:definition "A SKOS concept scheme that classifies contextual BFO roles borne by items and currencies within Guild Wars 2 crafting, commerce, and combat systems."@en .

role:GameRole a owl:Class ;
    rdfs:subClassOf priory:Entity, bfo:BFO_0000023 ;
    owl:disjointWith bfo:BFO_0000004, iao:IAO_0000030 ;
    rdfs:label "Contextual Game Role"@en ;
    skos:prefLabel "Game Role"@en ;
    skos:definition "A BFO role that inheres in a game item or ledger token when that entity participates in a specific systemic gameplay context such as crafting, forging, bartering, or combat."@en ;
    rdfs:comment "A BFO realizable role assumed by an item or currency within a specific gameplay context (crafting, Mystic Forge, vendor exchange, or combat loadout)."@en .

role:CraftingIngredient a owl:NamedIndividual, role:GameRole, skos:Concept ;
    skos:inScheme role:GameRoleScheme ;
    rdfs:label "Crafting Ingredient Role"@en ;
    skos:prefLabel "Crafting Ingredient"@en ;
    skos:definition "A contextual game role borne by an item or currency when it is required as a quantitative input in a discipline crafting recipe."@en .

role:MysticForgeInput a owl:NamedIndividual, role:GameRole, skos:Concept ;
    skos:inScheme role:GameRoleScheme ;
    rdfs:label "Mystic Forge Input Role"@en ;
    skos:prefLabel "Mystic Forge Input"@en ;
    skos:definition "A contextual game role borne by an item when it is offered as one of the four input stacks in a Mystic Forge transformation."@en .

role:Precursor a owl:NamedIndividual, role:GameRole, skos:Concept ;
    skos:inScheme role:GameRoleScheme ;
    rdfs:label "Legendary Precursor Role"@en ;
    skos:prefLabel "Precursor"@en ;
    skos:definition "A contextual game role borne by an Exotic or Ascended weapon, armor piece, or backpack when it serves as the base artifact transformed into a Legendary item."@en .

role:CurrencyExchange a owl:NamedIndividual, role:GameRole, skos:Concept ;
    skos:inScheme role:GameRoleScheme ;
    rdfs:label "Currency / Barter Medium Role"@en ;
    skos:prefLabel "Currency Exchange"@en ;
    skos:definition "A contextual game role borne by a wallet currency or containerized barter token when it functions as a medium of exchange at an NPC vendor."@en .

role:EquipmentLoadout a owl:NamedIndividual, role:GameRole, skos:Concept ;
    skos:inScheme role:GameRoleScheme ;
    rdfs:label "Equipped Combat Loadout Role"@en ;
    skos:prefLabel "Equipment Loadout"@en ;
    skos:definition "A contextual game role borne by an equipable weapon, armor piece, trinket, or backpack when it is actively slotted in a character's combat equipment template."@en .

role:UpgradeSlotComponent a owl:NamedIndividual, role:GameRole, skos:Concept ;
    skos:inScheme role:GameRoleScheme ;
    rdfs:label "Slotted Upgrade Component Role"@en ;
    skos:prefLabel "Upgrade Slot Component"@en ;
    skos:definition "A contextual game role borne by a rune, sigil, infusion, or relic when it is inserted into an upgrade slot to modify equipment attributes or combat effects."@en .

role:ConsumableUtility a owl:NamedIndividual, role:GameRole, skos:Concept ;
    skos:inScheme role:GameRoleScheme ;
    rdfs:label "Consumable / Utility Gizmo Role"@en ;
    skos:prefLabel "Consumable Utility"@en ;
    skos:definition "A contextual game role borne by a consumable booster, container, or convenience gizmo when activated by a player to grant a buff, unpack rewards, or access hub services."@en .

role:JunkSell a owl:NamedIndividual, role:GameRole, skos:Concept ;
    skos:inScheme role:GameRoleScheme ;
    rdfs:label "Merchant Liquidation Role"@en ;
    skos:prefLabel "Junk / Vendor Sell"@en ;
    skos:definition "A contextual game role borne by a trophy or junk item whose systemic utility consists in being sold to an NPC merchant for copper coin."@en .
