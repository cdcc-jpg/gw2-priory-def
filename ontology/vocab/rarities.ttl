@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix priory-ref: <https://priory.gw2/ref/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .

priory-ref:RarityScheme a skos:ConceptScheme ;
    skos:prefLabel "Guild Wars 2 Item Rarity Scheme"@en ;
    rdfs:comment "Controlled vocabulary of item rarities in Guild Wars 2 with tier levels and color codes."@en ;
    skos:hasTopConcept rarity:Junk, rarity:Basic, rarity:Fine, rarity:Masterwork, rarity:Rare, rarity:Exotic, rarity:Ascended, rarity:Legendary .

rarity:Junk a skos:Concept ;
    skos:inScheme priory-ref:RarityScheme ;
    skos:topConceptOf priory-ref:RarityScheme ;
    skos:prefLabel "Junk"@en ;
    skos:notation "0"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Junk> .

rarity:Basic a skos:Concept ;
    skos:inScheme priory-ref:RarityScheme ;
    skos:topConceptOf priory-ref:RarityScheme ;
    skos:prefLabel "Basic"@en ;
    skos:notation "1"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Basic> .

rarity:Fine a skos:Concept ;
    skos:inScheme priory-ref:RarityScheme ;
    skos:topConceptOf priory-ref:RarityScheme ;
    skos:prefLabel "Fine"@en ;
    skos:notation "2"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Fine> .

rarity:Masterwork a skos:Concept ;
    skos:inScheme priory-ref:RarityScheme ;
    skos:topConceptOf priory-ref:RarityScheme ;
    skos:prefLabel "Masterwork"@en ;
    skos:notation "3"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Masterwork> .

rarity:Rare a skos:Concept ;
    skos:inScheme priory-ref:RarityScheme ;
    skos:topConceptOf priory-ref:RarityScheme ;
    skos:prefLabel "Rare"@en ;
    skos:notation "4"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Rare> .

rarity:Exotic a skos:Concept ;
    skos:inScheme priory-ref:RarityScheme ;
    skos:topConceptOf priory-ref:RarityScheme ;
    skos:prefLabel "Exotic"@en ;
    skos:notation "5"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Exotic> .

rarity:Ascended a skos:Concept ;
    skos:inScheme priory-ref:RarityScheme ;
    skos:topConceptOf priory-ref:RarityScheme ;
    skos:prefLabel "Ascended"@en ;
    skos:notation "6"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Ascended> .

rarity:Legendary a skos:Concept ;
    skos:inScheme priory-ref:RarityScheme ;
    skos:topConceptOf priory-ref:RarityScheme ;
    skos:prefLabel "Legendary"@en ;
    skos:notation "7"^^xsd:integer ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Legendary> .
