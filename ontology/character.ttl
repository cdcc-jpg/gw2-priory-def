# ==============================================================================
# Default Account Character Roster (Fallback Profile)
# ==============================================================================

priory:DefaultRosterMember a owl:Class ;
    rdfs:subClassOf priory:Entity ;
    rdfs:label "Default Account Roster Member"@en ;
    skos:definition "A default fallback character roster entry used when live GW2 API character rosters are not provided."@en .

priory:rosterOrder a owl:DatatypeProperty ;
    rdfs:domain priory:Entity ;
    rdfs:range xsd:integer ;
    rdfs:label "roster display order"@en ;
    skos:definition "An integer datatype property specifying the canonical sequence index of a character in the default account roster."@en .

priory:rosterCharacterName a owl:DatatypeProperty ;
    rdfs:domain priory:DefaultRosterMember ;
    rdfs:range xsd:string ;
    rdfs:label "default roster character name"@en ;
    skos:definition "A string datatype property recording the character name of a default account roster entry."@en .

