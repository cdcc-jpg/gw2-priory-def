# ==============================================================================
# Project Priory Environment Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# 1. Guild Wars 2 Official Account API Key (from https://account.arena.net/applications)
# Recommended permissions: 'account', 'inventories', 'characters', 'wallet', 'unlocks', 'progression'
GW2_API_KEY=

# 2. Google Gemini API Key (Optional: for live LLM reasoning via Google AI Studio)
# Free key available at: https://aistudio.google.com/
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest # Default cheap/fast model (e.g. gemini-flash-lite-latest, gemini-3.1-flash-lite)

# 3. Local Ollama Host (Optional: if running local models on your Mac)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
